      "source_sha256": "645f3e323cd8c4b4216c4853162e4430d0f78825871206a50ac6f730e2a3fb3f",
      "target": "“Hello...?”<END>",
      "review_status": "draft"
    },
    {
      "key": "base:t00_17422",
      "source_sha256": "9f75244180b1ecd94939e1ea546b948afb6d636c85a91f02608ab106bc5f56f5",
      "target": "“Hello, Lawrence. You're looking well.”<END>",
      "review_status": "draft"
    },
    {
      "key": "base:t00_17423",
      "source_sha256": "0092d5080d71014df6dd97385d287a1b8108371d54bc2c45ae052f3187dac3a0",
      "target": "“My, it has been a long time.<STOP>If you're using this channel, could it mean...?”<END>",
      "review_status": "draft"
    },
    {
      "key": "base:t00_17424",
      "source_sha256": "8d72666729c80c9fca18967e21acf9aba51c8ec31782393ad3000a2d7e9e2964",
      "target": "“Yes. It's about time we made our move.<STOP>Is <G:0126><G:0126><G:0126><G:0126><G:0126> there?”<END>",
      "review_status": "draft"
    },
    {
      "key": "base:t00_17425",
