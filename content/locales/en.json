      "target": "“Ah...!”<END>",
      "review_status": "draft"
    },
    {
      "key": "base:t00_17439",
      "source_sha256": "b0d550824b9f6a2890f36975e00a1f37396378d54d4837fe76cea4d1f8aa5734",
      "target": "“What do you think?”<END>",
      "review_status": "draft"
    },
    {
