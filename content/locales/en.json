      "source_sha256": "49c6cdefc7d5c4784e8ff4c2666e20da0e55921eba773bf5386b11c331078408",
      "target": "“Good grief. She certainly doesn't hesitate to act.<STOP>Garrison, I'm heading out too. I'll leave the rest to you.”<END>",
      "review_status": "draft"
    },
    {
      "key": "base:t00_17462",
      "source_sha256": "4e1ccf873f48c98c043b5f9d6e7417dd50f64c32cad7fb934f414553645e1531",
