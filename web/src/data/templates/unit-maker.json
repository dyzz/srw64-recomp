    "mod.json": {
      "schema": "srw64.mod.v1",
      "id": "yourname.units",
      "version": "1.0.0",
      "name": {
        "zh-Hans": "机体 MOD 模板",
        "en": "Unit mod template",
        "ja": "ユニット MOD テンプレート"
      },
      "license": "CC-BY-4.0",
      "authors": [
        "yourname"
      ],
      "game": ">=0.5.4",
      "description": {
        "zh-Hans": "模板：新人物天城圭（照抄西布克）驾驶新机体高达改（照抄高达），带一件新武器强化光束步枪；第 7 话「苦痛之刃」过关后加入。改名字、数值、台词和入队的关卡，就是你自己的包。",
        "en": "Template: a new character, Kei Amagi (a copy of Seabook), in a new unit, the Gundam Kai (a copy of the Gundam), with a new Enhanced Beam Rifle; joins after episode 7, \"Blade of Anguish\". Change the names, numbers, lines and the joining stage to make it yours.",
        "ja": "テンプレート：新キャラクター「ケイ・アマギ」（シーブックのコピー）が新ユニット「ガンダム改」（ガンダムのコピー）と新武器「強化ビームライフル」で、第7話「苦しみの刃」クリア後に加入します。名前・数値・台詞・加入ステージを変えれば自分のパッケージになります。"
      }
    },
