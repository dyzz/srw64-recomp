    "dialogue/battle_quotes.json": {
      "schema": "srw64.battle-quotes.v1",
      "pilots": {
        "@kei": {
          "attack": [
            {
              "ja": "「行けっ、ガンダム改！」",
              "zh-Hans": "“上吧，高达改！”",
              "en": "\"Go, Gundam Kai!\"",
              "ko": "「가라, 건담 개!」"
            },
            {
              "ja": "「この距離なら外さない！」",
              "zh-Hans": "“这个距离不会打偏！”",
              "en": "\"I won't miss from here!\"",
              "ko": "「이 거리라면 빗나가지 않아!」"
            }
          ],
          "shot_down": [
            {
              "ja": "「ごめん……みんな……！」",
              "zh-Hans": "“对不起……大家……！”",
              "en": "\"Sorry... everyone...!\"",
              "ko": "「미안해…… 모두……!」"
            }
          ],
          "heavy": [
            {
              "ja": "「くっ……まだ動けるか！？」",
              "zh-Hans": "“呜……还能动吗！？”",
              "en": "\"Ngh... can it still move!?\"",
              "ko": "「큭…… 아직 움직일 수 있나!?」"
            }
          ],
          "evade": [
            {
              "ja": "「見えてるよ！」",
              "zh-Hans": "“看得一清二楚！”",
              "en": "\"I can see it coming!\"",
              "ko": "「다 보여!」"
            }
          ]
        }
      }
