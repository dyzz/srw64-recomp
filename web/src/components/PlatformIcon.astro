---
// The install page's platform marks: the Windows and Apple glyphs from Bootstrap Icons (MIT),
// plain line drawings for the rest.
interface Props { id: string; }
const { id } = Astro.props;
const line = { viewBox: '0 0 24 24', fill: 'none', stroke: 'currentColor', 'stroke-width': 2, 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const;
const solid = { viewBox: '0 0 16 16', fill: 'currentColor' } as const;
---
{id === 'windows' && <svg {...solid} aria-hidden="true"><path d="M6.555 1.375 0 2.237v5.45h6.555zM0 13.795l6.555.933V8.313H0zm7.278-5.4.026 6.378L16 16V8.395zM16 0 7.33 1.244v6.414H16z" /></svg>}
{id === 'macos' && <svg {...solid} aria-hidden="true"><path d="M11.182.008C11.148-.03 9.923.023 8.857 1.18c-1.066 1.156-.902 2.482-.878 2.516s1.52.087 2.475-1.258.762-2.391.728-2.43m3.314 11.733c-.048-.096-2.325-1.234-2.113-3.422s1.675-2.789 1.698-2.854-.597-.79-1.254-1.157a3.7 3.7 0 0 0-1.563-.434c-.108-.003-.483-.095-1.254.116-.508.139-1.653.589-1.968.607-.316.018-1.256-.522-2.267-.665-.647-.125-1.333.131-1.824.328-.49.196-1.422.754-2.074 2.237-.652 1.482-.311 3.83-.067 4.56s.625 1.924 1.273 2.796c.576.984 1.34 1.667 1.659 1.899s1.219.386 1.843.067c.502-.308 1.408-.485 1.766-.472.357.013 1.061.154 1.782.539.571.197 1.111.115 1.652-.105.541-.221 1.324-1.059 2.238-2.758q.52-1.185.473-1.282" /></svg>}
{id === 'linux' && <svg {...line} aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M7 9l3 3-3 3M13 15h4" /></svg>}
{id === 'steam-deck' && <svg {...line} aria-hidden="true"><rect x="1.5" y="6.5" width="21" height="11" rx="4" /><rect x="7.5" y="9.5" width="9" height="5" /></svg>}
{id === 'android' && <svg {...line} aria-hidden="true"><path d="M3.5 18a8.5 8.5 0 0 1 17 0z" /><path d="M7.5 7.5 5.5 4.5M16.5 7.5l2-3M9 13.5h.01M15 13.5h.01" /></svg>}
{id === 'switch' && <svg {...line} aria-hidden="true"><rect x="1.5" y="5" width="6.5" height="14" rx="3" /><rect x="16" y="5" width="6.5" height="14" rx="3" /><path d="M8 7h8M8 17h8M4.8 9.5h.01M19.2 14.5h.01" /></svg>}
{id === 'hd' && <svg {...line} aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="1" /><path d="M6 9v6M11 9v6M6 12h5M15 9v6h1.5a3 3 0 0 0 0-6z" /></svg>}
