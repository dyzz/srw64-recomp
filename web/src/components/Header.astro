---
import { LANGS, UI, canReview, langInfo, switchLang, type Lang } from '../i18n';
import Wordmark from './Wordmark.astro';
interface Props { lang: Lang; path: string; review?: boolean; }
const { lang, path, review = false } = Astro.props;
const items = [
  { href: `/${lang}/`, label: UI.nav.home[lang], match: (p: string) => p === `/${lang}/` },
  { href: `/${lang}/install/`, label: UI.nav.install[lang], match: (p: string) => p.startsWith(`/${lang}/install`) },
  { href: `/${lang}/guide/`, label: UI.nav.guide[lang], match: (p: string) => p.startsWith(`/${lang}/guide`) },
  { href: `/${lang}/story/`, label: UI.nav.story[lang], match: (p: string) => p.startsWith(`/${lang}/story`) },
  { href: `/${lang}/library/`, label: UI.nav.library[lang], match: (p: string) => p.startsWith(`/${lang}/library`) },
  ...(canReview(lang) ? [{ href: `/${lang}/reviews/`, label: UI.nav.reviews[lang], match: (p: string) => p.startsWith(`/${lang}/reviews`) }] : []),
  { href: `/${lang}/faq/`, label: UI.nav.faq[lang], match: (p: string) => p.startsWith(`/${lang}/faq`) },
  { href: `/${lang}/blog/`, label: UI.nav.blog[lang], match: (p: string) => p.startsWith(`/${lang}/blog`) },
  { href: `/${lang}/docs/`, label: UI.nav.docs[lang], match: (p: string) => p.startsWith(`/${lang}/docs`) },
];
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href={`/${lang}/`}>
      <img class="icon" src="/brand/icon-64.png" alt="" width="34" height="34" />
      <Wordmark />
    </a>
    <nav class="nav" aria-label="Main">
      {items.map((it) => <a href={it.href} aria-current={it.match(path) ? 'page' : undefined}>{it.label}</a>)}
    </nav>
    <div class="tools">
      {review && canReview(lang) && <div class="hdr-id" data-identity-chip data-lang={lang}></div>}
      <details class="lang">
        <summary aria-label={UI.lang[lang]}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.93 6h-2.95a15.6 15.6 0 0 0-1.38-3.56A8.03 8.03 0 0 1 18.93 8ZM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96ZM4.26 14a8.2 8.2 0 0 1 0-4h3.38a16.5 16.5 0 0 0 0 4H4.26Zm.81 2h2.95c.32 1.25.78 2.45 1.38 3.56A8 8 0 0 1 5.07 16Zm2.95-8H5.07a8 8 0 0 1 4.33-3.56A15.6 15.6 0 0 0 8.02 8ZM12 19.96A14.1 14.1 0 0 1 10.09 16h3.82A14.1 14.1 0 0 1 12 19.96ZM14.34 14H9.66a14.7 14.7 0 0 1 0-4h4.68a14.7 14.7 0 0 1 0 4Zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95a8.03 8.03 0 0 1-4.33 3.56ZM16.36 14a16.5 16.5 0 0 0 0-4h3.38a8.2 8.2 0 0 1 0 4h-3.38Z"/></svg>
          <span>{langInfo(lang).short}</span>
        </summary>
        <ul>
          {LANGS.map((l) => (
            <li><a href={switchLang(path, l.code)} hreflang={l.tag} lang={l.tag} aria-current={l.code === lang ? 'true' : undefined}>{l.label}</a></li>
          ))}
        </ul>
      </details>
      <a class="gh" href="https://github.com/dyzz/srw64-recomp" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
      </a>
    </div>
  </div>
</header>
<script>
  import { mountIdentityChip } from '../scripts/identity';
  const chip = document.querySelector<HTMLElement>('[data-identity-chip]');
  if (chip) mountIdentityChip(chip, chip.dataset.lang as 'zh');
</script>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 20;
    background: rgba(7, 11, 29, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line-soft);
  }
  .bar { display: flex; align-items: center; gap: 28px; height: 64px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; color: var(--text); font-size: 22px; font-weight: 700; letter-spacing: 0.04em; text-decoration: none; }
  .logo b { color: var(--gold); font-weight: 700; }
  .icon { width: 34px; height: 34px; }
  .nav { display: flex; gap: 4px; flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  .nav::-webkit-scrollbar { display: none; }
  .nav a { position: relative; padding: 8px 12px; color: var(--muted); font-size: 15px; text-decoration: none; white-space: nowrap; }
  .nav a:hover { color: var(--text); }
  .nav a[aria-current='page'] { color: var(--text); }
  .nav a[aria-current='page']::after { content: ''; position: absolute; left: 12px; right: 12px; bottom: 0; height: 2px; background: var(--gold); }
  .tools { display: flex; align-items: center; gap: 6px; }
  .gh { display: grid; place-items: center; width: 38px; height: 38px; color: var(--muted); }
  .gh:hover { color: var(--text); }
  .lang { position: relative; }
  .lang summary { list-style: none; display: flex; align-items: center; gap: 6px; height: 38px; padding: 0 10px; color: var(--muted); cursor: pointer; border: 1px solid var(--line-soft); border-radius: var(--radius); font-size: 14px; }
  .lang summary::-webkit-details-marker { display: none; }
  .lang summary:hover, .lang[open] summary { color: var(--text); border-color: var(--cyan); }
  .lang ul { position: absolute; right: 0; top: calc(100% + 6px); margin: 0; padding: 6px; list-style: none; min-width: 150px; background: var(--panel); border: 1px solid var(--line); box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5); }
  .lang ul a { display: block; padding: 8px 12px; color: var(--text); text-decoration: none; }
  .lang ul a:hover { background: var(--cyan-soft); }
  .lang ul a[aria-current] { color: var(--gold); }
  .hdr-id { position: relative; }
  @media (max-width: 480px) {
    .gh { display: none; }
    .lang summary { padding: 0 8px; }
    .lang summary span { display: none; }
  }
  /* Narrower desktops: the header stays one 64px row (sticky bars below assume that
     height), so the nav tightens and, if still too wide, scrolls sideways. */
  @media (max-width: 1180px) {
    .bar { gap: 16px; }
    .nav { gap: 0; }
    .nav a { padding: 8px; font-size: 14px; }
    .nav a[aria-current='page']::after { left: 8px; right: 8px; }
  }
  @media (max-width: 720px) {
    .bar { flex-wrap: wrap; height: auto; padding-top: 10px; padding-bottom: 4px; gap: 0 12px; }
    .logo { flex: 1; }
    .nav { order: 3; flex-basis: 100%; margin: 0 -8px; }
  }
</style>
