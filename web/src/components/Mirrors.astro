---
// The netdisk mirrors (release.ts mirrors), for readers in mainland China who cannot
// download from GitHub: on the home page under the download button, atop the install page and
// (compact: no note) under each platform's download there. Simplified and Traditional Chinese
// pages only (user, 2026-11-07): nobody else needs them.
import { mirrors } from '../data/release';
import { tl, type Lang } from '../i18n';
interface Props { lang: Lang; compact?: boolean; }
const { lang, compact = false } = Astro.props;
const name = { quark: '夸克网盘', baidu: '百度网盘' };
---
{tl(lang) === 'zh' && mirrors.length > 0 && (
  <p class:list={['mirrors', { compact }]}>
    <span class="lead">国内下载：</span>
    {mirrors.map((m, i) => (
      <>{i > 0 && <span class="sep"> · </span>}<a href={m.url} data-umami-event="download-mirror" data-umami-event-mirror={m.id} data-umami-event-language={lang}>{name[m.id]}{m.passcode && `（提取码 ${m.passcode}）`}</a></>
    ))}
    {!compact && <span class="note"> 程序和 HD 包都在里面。</span>}
  </p>
)}

<style>
  .mirrors { margin: 14px 0 0; font-size: 16px; line-height: 1.7; }
  .mirrors.compact { margin-top: 8px; font-size: 14px; line-height: 1.6; }
  .mirrors .lead { font-weight: 700; }
  .mirrors a { font-weight: 700; white-space: nowrap; }
  .mirrors .note { color: var(--muted); font-size: 14px; }
</style>
