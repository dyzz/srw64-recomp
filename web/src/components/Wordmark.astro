---
// The MARCHWIND 64 wordmark: MARCHWIND carries the name, 64 is a small model mark
// beside it (never the big gold 64 of the original logo). Text, so it scales and
// stays crisp; swap in the drawn logo once it exists as a transparent file.
interface Props { size?: 'nav' | 'hero' | 'foot'; }
const { size = 'nav' } = Astro.props;
---
<span class={`wm ${size}`} aria-label="MARCHWIND 64" role="img">
  <span class="mw" aria-hidden="true">MARCHWIND</span><span class="v" aria-hidden="true">64</span>
</span>

<style>
  .wm { display: inline-flex; align-items: flex-start; gap: 0.18em; font-family: 'Chakra Petch', var(--sans); font-weight: 700; line-height: 1; white-space: nowrap; }
  .mw {
    display: inline-block; transform: skewX(-10deg); letter-spacing: 0.02em;
    background: linear-gradient(180deg, #ffffff 0%, #e3ebf8 48%, #9fb2d6 52%, #dce6f6 100%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    filter: drop-shadow(0 0 1px rgba(63, 208, 255, 0.9)) drop-shadow(0 2px 6px rgba(0, 0, 0, 0.5));
  }
  .v { display: inline-block; transform: skewX(-10deg); color: var(--gold); font-size: 0.5em; padding: 0.08em 0.28em; border: 0.08em solid rgba(255, 215, 94, 0.7); margin-top: 0.1em; letter-spacing: 0.04em; }
  .nav { font-size: 22px; }
  .foot { font-size: 20px; }
  .hero { font-size: clamp(44px, 7.4vw, 92px); }
  .hero .mw { filter: drop-shadow(0 0 2px rgba(63, 208, 255, 0.9)) drop-shadow(0 6px 24px rgba(0, 0, 0, 0.7)); }
</style>
