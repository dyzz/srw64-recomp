---
// The website ID is public; credentials stay on the analytics server.
const websiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID?.trim();
if (websiteId && !/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test(websiteId)) {
  throw new Error('PUBLIC_UMAMI_WEBSITE_ID must be a UUID');
}
---
{import.meta.env.PROD && websiteId && <meta name="umami-website-id" content={websiteId} />}
<script>
  const websiteId = document.querySelector<HTMLMetaElement>('meta[name="umami-website-id"]')?.content;
  if (websiteId && location.hostname === 'srw64.dreamquest.club') {
    // Query strings stay out of the statistics, except the utm_ parameters an ad's link
    // carries (ChatGPT ads and the like), which Umami's UTM report reads from the page
    // address. Referrers lose their query entirely. Umami calls this by name before each send.
    const onlyUtm = (address: unknown, keepUtm: boolean) => {
      if (typeof address !== 'string' || !address.includes('?')) return address;
      try {
        const u = new URL(address, location.origin);
        const kept = new URLSearchParams();
        if (keepUtm) u.searchParams.forEach((v, k) => { if (/^utm_[a-z]+$/.test(k)) kept.append(k, v); });
        u.search = kept.toString();
        // Umami sends a same-site referrer as a path; keep it that way.
        return address.startsWith('/') ? u.pathname + u.search : u.toString();
      } catch {
        return address.split('?')[0];
      }
    };
    (window as Window & { srw64UmamiBeforeSend?: unknown }).srw64UmamiBeforeSend = (_type: string, payload: Record<string, unknown>) => {
      payload.url = onlyUtm(payload.url, true);
      payload.referrer = onlyUtm(payload.referrer, false);
      return payload;
    };
    // Same-origin script and collection: works with the site's existing CSP.
    const tracker = document.createElement('script');
    tracker.src = '/analytics/script.js';
    tracker.defer = true;
    tracker.dataset.websiteId = websiteId;
    tracker.dataset.hostUrl = `${location.origin}/analytics`;
    tracker.dataset.domains = 'srw64.dreamquest.club';
    tracker.dataset.beforeSend = 'srw64UmamiBeforeSend';
    tracker.dataset.excludeHash = 'true';
    tracker.dataset.doNotTrack = 'true';
    document.head.append(tracker);
    // Umami's automatic link handler redirects after tracking. Keep the native
    // download attribute on the offline guide so it still saves the file.
    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('[data-guide-download]') : null;
      const umami = (window as Window & { umami?: { track: (name: string, data: Record<string, string>) => Promise<void> } }).umami;
      if (link && umami) void umami.track('download', { platform: 'guide', language: link.dataset.guideDownload!, source: 'guide' });
    });
  }
  // OpenAI ads pixel. Its script comes from bzrcdn.openai.com and it reports to
  // bzr.openai.com; both are allowed in astro.config.mjs's Content-Security-Policy.
  // The calls queue at once; the script itself is added only after the page's load event,
  // so where openai.com cannot be reached (mainland China) the tab does not keep loading.
  if (location.hostname === 'srw64.dreamquest.club') {
    const w = window as Window & { oaiq?: ((...args: unknown[]) => void) & { q: unknown[][] } };
    if (!w.oaiq) {
      const q = Object.assign((...args: unknown[]) => { q.q.push(args); }, { q: [] as unknown[][] });
      w.oaiq = q;
      q('init', { pixelId: 'VQG6VczK9U6mg5komRdZQc', debug: true });
      const add = () => {
        const sdk = document.createElement('script');
        sdk.async = true;
        sdk.src = 'https://bzrcdn.openai.com/sdk/oaiq.min.js';
        document.head.append(sdk);
      };
      if (document.readyState === 'complete') add();
      else addEventListener('load', add, { once: true });
    }
    document.addEventListener('click', (event) => {
      const link = event.target instanceof Element
        ? event.target.closest('a[data-umami-event="download"], a[data-umami-event="download-mirror"]')
        : null;
      if (link) {
        w.oaiq?.('measure', 'custom', { type: 'custom' }, { custom_event_name: 'download_click' });
      }
    }, { capture: true });
  }
</script>
