---
import type { Lang } from '../i18n';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const copy = {
  zh: ['观看功能演示', '在 YouTube 观看', '关闭'],
  tw: ['觀看功能演示', '在 YouTube 觀看', '關閉'],
  en: ['Watch the feature overview', 'Watch on YouTube', 'Close'],
  ja: ['機能紹介を見る', 'YouTube で見る', '閉じる'],
  ko: ['기능 소개 영상 보기', 'YouTube에서 보기', '닫기'],
};
const [title, external, close] = copy[lang];
const videoId = 'F9cq5RtVZ8I';
const watch = `https://www.youtube.com/watch?v=${videoId}`;
---
<div class="hero-video">
  <a id="feature-video-title" class="video-trigger" href={watch} data-feature-video={videoId}>
    <span aria-hidden="true">▶</span> {title} <span class="duration">1:35</span>
  </a>
  <dialog aria-label={title}>
    <div class="video-actions">
      <a href={watch} target="_blank" rel="noopener noreferrer">{external} ↗</a>
      <form method="dialog"><button type="submit" autofocus>{close}</button></form>
    </div>
    <div class="video-frame"></div>
  </dialog>
</div>

<script>
  const trigger = document.querySelector<HTMLAnchorElement>('[data-feature-video]');
  const dialog = trigger?.parentElement?.querySelector('dialog');
  const frame = dialog?.querySelector('.video-frame');
  if (trigger && dialog && frame) {
    trigger.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();
      const player = document.createElement('iframe');
      player.title = dialog.getAttribute('aria-label') || 'Marchwind 64';
      player.src = `https://www.youtube-nocookie.com/embed/${trigger.dataset.featureVideo}?autoplay=1`;
      player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      player.allowFullscreen = true;
      frame.replaceChildren(player);
      dialog.showModal();
    });
    dialog.addEventListener('close', () => frame.replaceChildren());
  }
</script>

<style>
  .video-trigger { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 12px; color: #f2f5ff; background: #090d21ee; border: 1px solid #8ce7ef; border-radius: 7px; font-size: 14px; text-decoration: none; }
  .video-trigger:hover, .video-trigger:focus-visible { background: #18334d; }
  .duration { color: #b8dfe8; font-variant-numeric: tabular-nums; }
  dialog { width: min(920px, calc(100% - 24px)); max-width: none; padding: 10px; border: 1px solid var(--line, #35405d); border-radius: 10px; color: #f2f5ff; background: #090d21; }
  dialog::backdrop { background: rgb(3 6 17 / 82%); }
  .video-actions { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding-bottom: 8px; }
  .video-actions button { min-height: 44px; padding: 0 12px; color: inherit; background: #18334d; border: 1px solid #8ce7ef; border-radius: 6px; cursor: pointer; }
  .video-frame { aspect-ratio: 16 / 9; background: #000; }
  .video-frame :global(iframe) { display: block; width: 100%; height: 100%; border: 0; }
</style>
