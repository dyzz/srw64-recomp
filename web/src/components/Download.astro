---
// The big download button. Every platform's button is rendered; a small script
// shows the one for the reader's system (all of them stay visible without it).
// A platform the current release has no file for links to its install steps. The HD
// pack, one download for every platform, has its own button beside them.
import { fileFor, hd, mb, release, PLATFORM_LABEL, type Platform } from '../data/release';
import Mirrors from './Mirrors.astro';
import type { Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = {
  other: { zh: '其他平台', en: 'Other platforms', ja: 'ほかのプラットフォーム' },
  steps: { zh: '查看安装方法', en: 'Installation instructions', ja: 'インストール方法を見る' },
  hd: { zh: '下载 HD 美术包', en: 'Download the HD art pack', ja: 'HD アートパックをダウンロード' },
  hdNote: { zh: '可选，各平台通用', en: 'optional, every platform', ja: '任意・全プラットフォーム共通' },
  hdHow: { zh: 'HD 包怎么装', en: 'Installing the HD pack', ja: 'HD パックの入れ方' },
};
const hdFile = fileFor('hd');
const platforms: Platform[] = ['windows', 'macos', 'linux', 'android'];
const label = (p: Platform) =>
  lang === 'en' ? `Download for ${PLATFORM_LABEL[p]}` : lang === 'ja' ? `${PLATFORM_LABEL[p]} 版をダウンロード` : `下载 ${PLATFORM_LABEL[p]} 版`;
const items = platforms.map((p) => {
  const f = fileFor(p);
  return f
    ? { p, href: f.url, text: label(p), small: `v${release.version} · ${mb(f.bytes)}`, file: true }
    : { p, href: `/${lang}/install/#${p}`, text: `${PLATFORM_LABEL[p]}`, small: t.steps[lang], file: false };
});
---
<div class="dl" data-dl>
  {items.map((it) => (
    <a class={`btn big ${it.file ? '' : 'ghost'}`} href={it.href} data-platform={it.p} data-file={it.file ? '1' : undefined}
      data-umami-event={it.file ? 'download' : undefined} data-umami-event-platform={it.p} data-umami-event-language={lang} data-umami-event-source="home">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17V3Zm-7 16h16v2H4v-2Z"/></svg>
      <span>{it.text}<small>{it.small}</small></span>
    </a>
  ))}
</div>
{hdFile && (
  <a class="btn cyan hd" href={hdFile.url} data-umami-event="download" data-umami-event-platform="hd" data-umami-event-language={lang} data-umami-event-source="home">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17V3Zm-7 16h16v2H4v-2Z"/></svg>
    <span>{t.hd[lang]}<small>{hd.version && `HD ${hd.version} · `}{mb(hdFile.bytes)} · {t.hdNote[lang]}</small></span>
  </a>
)}
<Mirrors lang={lang} />
<p class="more">
  <a class="other" href={`/${lang}/install/#downloads`} data-other hidden>{t.other[lang]} →</a>
  {hdFile && <a href={`/${lang}/install/#hd`}>{t.hdHow[lang]} →</a>}
</p>

<script>
  const root = document.querySelector<HTMLElement>('[data-dl]');
  if (root) {
    const ua = navigator.userAgent;
    const p = /Android/.test(ua) ? 'android'
      : /iPhone|iPad/.test(ua) ? null
      : /Windows/.test(ua) ? 'windows'
      : /Mac OS X|Macintosh/.test(ua) ? 'macos'
      : /Linux|X11|CrOS/.test(ua) ? 'linux' : null;
    if (p) {
      root.querySelectorAll<HTMLElement>('[data-platform]').forEach((a) => { a.hidden = a.dataset.platform !== p; });
      root.classList.add('one');
      document.querySelector<HTMLElement>('[data-other]')!.hidden = false;
    } else {
      // Desktop-less or unknown systems see the platforms that have a download.
      root.querySelectorAll<HTMLElement>('[data-platform]:not([data-file])').forEach((a) => { a.hidden = true; });
    }
  }
</script>

<style>
  .dl { display: flex; flex-wrap: wrap; gap: 10px; }
  .dl .btn { text-align: left; }
  .dl .btn[hidden] { display: none; }
  .dl:not(.one) .btn { min-height: 56px; font-size: 15px; }
  .hd { margin-top: 10px; text-align: left; min-height: 50px; }
  .more { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 10px 0 0; font-size: 14px; }
  .other[hidden] { display: none; }
</style>
