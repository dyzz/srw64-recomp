---
// The big download button. Every platform's button is rendered; a small script
// shows the one for the reader's system (all of them stay visible without it).
// A platform the current release has no file for links to its install steps. The HD
// pack, one download for the computers and Android, has its own button beside them. The
// Switch is downloaded from another device, so its package and its own HD pack are a row
// of their own that the script never hides.
import { fileFor, hd, mb, release, PLATFORM_LABEL, type Platform } from '../data/release';
import Mirrors from './Mirrors.astro';
import { UI, tl, type Lang } from '../i18n';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = {
  other: { zh: '其他平台', en: 'Other platforms', ja: 'ほかのプラットフォーム', ko: '다른 플랫폼' },
  steps: { zh: '查看安装方法', en: 'Installation instructions', ja: 'インストール方法を見る', ko: '설치 방법 보기' },
  hd: { zh: '下载 HD 美术包', en: 'Download the HD art pack', ja: 'HD アートパックをダウンロード', ko: 'HD 아트 팩 다운로드' },
  hdNote: { zh: '可选，电脑与 Android 通用', en: 'optional, computers and Android', ja: '任意・パソコンと Android 共通', ko: '선택 사항, PC와 Android 공용' },
  hdHow: { zh: 'HD 包怎么装', en: 'Installing the HD pack', ja: 'HD パックの入れ方', ko: 'HD 팩 설치 방법' },
  switchHd: { zh: '下载 Switch HD 美术包', en: 'Download the Switch HD art pack', ja: 'Switch 用 HD アートパックをダウンロード', ko: 'Switch용 HD 아트 팩 다운로드' },
  switchHdNote: { zh: '可选，Switch 专用', en: 'optional, Switch only', ja: '任意・Switch 専用', ko: '선택 사항, Switch 전용' },
};
const hdFile = fileFor('hd');
const switchFile = fileFor('switch');
const switchHdFile = fileFor('switch-hd');
const platforms: Platform[] = ['windows', 'macos', 'linux', 'android'];
const label = (p: Platform) =>
  lang === 'en' ? `Download for ${PLATFORM_LABEL[p]}` : lang === 'ja' ? `${PLATFORM_LABEL[p]} 版をダウンロード` : lang === 'ko' ? `${PLATFORM_LABEL[p]}용 다운로드` : `下载 ${PLATFORM_LABEL[p]} 版`;
const items = platforms.map((p) => {
  const f = fileFor(p);
  return f
    ? { p, href: f.url, text: label(p), small: `v${release.version} · ${mb(f.bytes)}`, file: true }
    : { p, href: `/${lang}/install/#${p}`, text: `${PLATFORM_LABEL[p]}`, small: t.steps[tl(lang)], file: false };
});
---
<div class="dl" data-dl>
  {items.map((it) => (
    <a class={`btn big ${it.file ? '' : 'ghost'}`} href={it.href} data-platform={it.p} data-file={it.file ? '1' : undefined}
      data-umami-event={it.file ? 'download' : undefined} data-umami-event-platform={it.p} data-umami-event-language={lang} data-umami-event-source="home">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17V3Zm-7 16h16v2H4v-2Z"/></svg>
      <span>{it.text}<small>{it.small}</small></span>
    </a>
  ))}
</div>
{hdFile && (
  <a class="btn cyan hd" href={hdFile.url} data-umami-event="download" data-umami-event-platform="hd" data-umami-event-language={lang} data-umami-event-source="home">
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17V3Zm-7 16h16v2H4v-2Z"/></svg>
    <span>{t.hd[tl(lang)]}<small>{hd.version && `HD ${hd.version} · `}{mb(hdFile.bytes)} · {t.hdNote[tl(lang)]}</small></span>
  </a>
)}
{switchFile && (
  <div class="switch">
    <a class="btn ghost" href={switchFile.url} data-umami-event="download" data-umami-event-platform="switch" data-umami-event-language={lang} data-umami-event-source="home">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17V3Zm-7 16h16v2H4v-2Z"/></svg>
      <span>{label('switch')}<small>v{release.version} · {mb(switchFile.bytes)}</small></span>
    </a>
    {switchHdFile && (
      <a class="btn ghost" href={switchHdFile.url} data-umami-event="download" data-umami-event-platform="switch-hd" data-umami-event-language={lang} data-umami-event-source="home">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M11 3h2v10.17l3.59-3.58L18 11l-6 6-6-6 1.41-1.41L11 13.17V3Zm-7 16h16v2H4v-2Z"/></svg>
        <span>{t.switchHd[tl(lang)]}<small>{hd.version && `HD ${hd.version} · `}{mb(switchHdFile.bytes)} · {t.switchHdNote[tl(lang)]}</small></span>
      </a>
    )}
  </div>
)}
<Mirrors lang={lang} />
<p class="more">
  <a class="other" href={`/${lang}/install/#downloads`} data-other hidden>{t.other[tl(lang)]} →</a>
  {hdFile && <a href={`/${lang}/install/#hd`}>{t.hdHow[tl(lang)]} →</a>}
  <a href={`/${lang}/releases/`}>{UI.nav.releases[tl(lang)]} →</a>
</p>

<script>
  const root = document.querySelector<HTMLElement>('[data-dl]');
  if (root) {
    const ua = navigator.userAgent;
    const p = /Android/.test(ua) ? 'android'
      : /iPhone|iPad/.test(ua) ? null
      : /Windows/.test(ua) ? 'windows'
      : /Mac OS X|Macintosh/.test(ua) ? 'macos'
      : /Linux|X11|CrOS/.test(ua) ? 'linux' : null;
    if (p) {
      root.querySelectorAll<HTMLElement>('[data-platform]').forEach((a) => { a.hidden = a.dataset.platform !== p; });
      root.classList.add('one');
      document.querySelector<HTMLElement>('[data-other]')!.hidden = false;
    } else {
      // Desktop-less or unknown systems see the platforms that have a download.
      root.querySelectorAll<HTMLElement>('[data-platform]:not([data-file])').forEach((a) => { a.hidden = true; });
    }
  }
</script>

<style>
  .dl { display: flex; flex-wrap: wrap; gap: 10px; }
  .dl .btn { text-align: left; }
  .dl .btn[hidden] { display: none; }
  .dl:not(.one) .btn { min-height: 56px; font-size: 15px; }
  .hd { margin-top: 10px; text-align: left; min-height: 50px; }
  .switch { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 10px; }
  .switch .btn { text-align: left; min-height: 50px; }
  .more { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 10px 0 0; font-size: 14px; }
  .other[hidden] { display: none; }
</style>
