---
import '@fontsource/chakra-petch/latin-500.css';
import '@fontsource/chakra-petch/latin-600.css';
import '@fontsource/chakra-petch/latin-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANGS, UI, langInfo, switchLang, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Pages where readers can suggest changes: the header shows their identity. */
  review?: boolean;
}
const { lang, title, description, review = false } = Astro.props;
const info = langInfo(lang);
const siteTitle = `${UI.brand} · ${UI.title[lang]}`;
const fullTitle = title ? `${title} · ${UI.brand}` : siteTitle;
const desc = description ?? UI.description[lang];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang={info.tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#070b1d" />
    <link rel="icon" href="/brand/icon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/brand/icon-64.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/brand/icon-180.png" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    {LANGS.map((l) => <link rel="alternate" hreflang={l.tag} href={new URL(switchLang(path, l.code), Astro.site)} />)}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL(`/media/hero-${lang}.webp`, Astro.site)} />
    <meta property="og:type" content="website" />
    <script is:inline>
      // Remember the language the reader chose, for the root page's redirect.
      try { localStorage.setItem('srw64-lang', document.documentElement.lang.startsWith('zh') ? 'zh' : document.documentElement.lang); } catch (e) {}
    </script>
  </head>
  <body>
    <Header lang={lang} path={path} review={review} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import { initLightbox } from '../scripts/lightbox';
      initLightbox();
    </script>
  </body>
</html>
