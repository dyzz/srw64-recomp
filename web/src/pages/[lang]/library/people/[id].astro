---
import Base from '../../../../layouts/Base.astro';
import { LANGS, UI, type Lang } from '../../../../i18n';
import { library, portraitUrl, type Person } from '../../../../lib/data';

export async function getStaticPaths() {
  return LANGS.flatMap((l) => library().people.map((p) => ({ params: { lang: l.code, id: String(p.id) } })));
}
const lang = Astro.params.lang as Lang;
const lib = library();
const p = lib.people.find((x) => x.id === Number(Astro.params.id)) as Person;
const L = (k: string) => lib.labels[k]?.[lang] ?? k;
const series = lib.series.find((s) => s.id === p.series)?.name[lang] ?? '';
const siblings = lib.people.filter((x) => x.series === p.series);
const i = siblings.indexOf(p);
const face = portraitUrl(p.portrait);
const order = ['melee', 'shooting', 'skill', 'reaction', 'hit', 'evade', 'sp'] as const;
const t = {
  suggest: { zh: '对译名提意见', en: 'Suggest a better name', ja: '名称に意見' },
  growth: { zh: 'Lv1 → Lv99', en: 'Lv1 → Lv99', ja: 'Lv1 → Lv99' },
};
const partner = (id: number) => lib.people.find((x) => x.id === id);
---
<Base lang={lang} title={`${p.name[lang]} · ${UI.nav.library[lang]}`}>
  <div class="wrap layout" data-library data-lang={lang} data-target-type="term" data-target-prefix="">
    <aside class="side">
      <a href={`/${lang}/library/#people`}>← {UI.nav.library[lang]}</a>
      <p class="series">{series}</p>
      <ul>
        {siblings.map((x) => <li><a href={`/${lang}/library/people/${x.id}/`} aria-current={x === p ? 'page' : undefined}>{x.name[lang]}</a></li>)}
      </ul>
    </aside>

    <main class="main">
      <div class="top">
        <div class="art">{face ? <img src={face} alt={p.name[lang]} width="160" height="160" /> : <span class="none"></span>}</div>
        <div class="info">
          <p class="crumb">{series}</p>
          <div class="namerow" data-term={`person:${p.id}`}>
            <h1>{p.name[lang]}</h1>
            {p.full_name[lang] !== p.name[lang] && <span class="full">{p.full_name[lang]}</span>}
            {lang !== 'ja' && <span class="jn" lang="ja">{p.full_name.ja}</span>}
            <span class="tr-zh" hidden>{p.name.zh}</span><span class="tr-en" hidden>{p.name.en}</span>
            <button type="button" class="act" data-suggest data-target-type="term" data-target-id={`person:${p.id}`}>{t.suggest[lang]}</button>
            <div data-term-body class="tb"></div>
          </div>
          <p class="badges">
            {p.double_move_level != null && <span class="cap">{L('library_double_move')} Lv{p.double_move_level}</span>}
            <span class={`pill ${p.enemy ? 'enemy' : ''}`}>{p.enemy ? L('library_enemy') : L('library_ally')}</span>
            {p.role === 'sub_pilot' && <span class="pill">{L('library_sub_pilot')}</span>}
            {p.role === 'fairy' && <span class="pill">{L('library_fairy')}</span>}
          </p>
          {p.no_battle || !p.stats ? <p class="dim">{L('library_no_stats')}</p> : <>
            {p.love.length > 0 && <p class="love"><span class="k">{L('library_love')}</span>
              {p.love.map((x) => { const q = partner(x.partner_id); return <a class="pill" href={`/${lang}/library/people/${x.partner_id}/`}>{q?.name[lang]} <em>{x.mutual ? L('library_love_mutual') : L('library_love_one_way')}</em></a>; })}
            </p>}
            <div class="stats">
              {order.map((k) => {
                const a = p.stats!.lv1[k], b = p.stats!.lv99[k];
                const top = 340;
                return <div class="stat"><span class="k">{L(k)}</span><span class="v latin">{a} <span class="to">→ {b}</span></span>
                  <span class="bar"><span class="a" style={`width:${Math.min(100, (a / top) * 100)}%`}></span><span class="b" style={`width:${Math.min(100, ((b - a) / top) * 100)}%`}></span></span></div>;
              })}
              <div class="stat legend"><span class="k">{t.growth[lang]}</span><span class="dim small">{L('library_growth_note')}</span></div>
            </div>
            {p.terrain && <p class="terrain"><span class="k">{L('terrain')}</span>
              {(['air', 'land', 'sea', 'space'] as const).map((k) => <span class={`pill t-${p.terrain![k]}`}>{L(k)} {p.terrain![k]}</span>)}
            </p>}
          </>}
        </div>
      </div>

      {p.spirits.length > 0 && <>
        <h2>{L('spirits')} <span class="dim small">{L('library_spirit_note')}</span></h2>
        <ul class="spirits">
          {p.spirits.map((s) => <li><strong>{s.name[lang]}</strong><span class="latin">Lv{s.level}</span><span class="dim">{L('library_spirit_cost').replace('{n}', String(s.cost))}</span></li>)}
        </ul>
      </>}
      {p.skills.length > 0 && <>
        <h2>{L('skills')} <span class="dim small">{L('library_skill_note')}</span></h2>
        <div class="skills">
          {p.skills.map((s) => (
            <div class="skill">
              <span class="sn">{s.name[lang]}</span>
              <div class="axis">
                {s.levels.map((l) => <span class="tick" style={`left:${((l.level - 1) / 98) * 100}%`} title={l.label[lang]}><i></i><b class="latin">{l.level}</b></span>)}
              </div>
            </div>
          ))}
        </div>
      </>}

      <nav class="pn">
        {i > 0 && <a href={`/${lang}/library/people/${siblings[i - 1].id}/`}>← {siblings[i - 1].name[lang]}</a>}
        {i < siblings.length - 1 && <a class="r" href={`/${lang}/library/people/${siblings[i + 1].id}/`}>{siblings[i + 1].name[lang]} →</a>}
      </nav>
    </main>
  </div>
  <script>
    import { initSuggestions } from '../../../../scripts/suggest';
    initSuggestions();
  </script>
</Base>

<style>
  .layout { display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start; padding-top: 28px; padding-bottom: 24px; }
  .side { flex: 1 1 220px; max-width: 260px; position: sticky; top: 84px; max-height: calc(100vh - 100px); overflow-y: auto; font-size: 14px; }
  .side .series { margin: 14px 0 6px; font-weight: 700; color: var(--cyan); }
  .side ul { list-style: none; margin: 0; padding: 0; }
  .side li a { display: block; padding: 6px 10px; color: var(--muted); text-decoration: none; border-left: 2px solid transparent; }
  .side li a:hover { color: var(--text); background: var(--cyan-soft); }
  .side li a[aria-current] { color: #fff; background: rgba(63, 208, 255, 0.14); border-left-color: var(--gold); }
  .main { flex: 999 1 560px; min-width: 0; }
  .top { display: flex; flex-wrap: wrap; gap: 28px; }
  .art { width: 220px; height: 220px; display: grid; place-items: center; background: var(--panel); border: 1px solid rgba(63, 208, 255, 0.25); }
  .art img { width: 200px; height: 200px; object-fit: cover; border-radius: 4px; }
  .art .none { width: 200px; height: 200px; background: var(--panel-2); }
  .info { flex: 1 1 380px; min-width: 0; display: grid; gap: 12px; align-content: start; }
  .crumb { font-size: 14px; color: var(--dim); }
  .namerow { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
  .namerow h1 { font-size: 38px; }
  .full { font-size: 18px; color: #d6ddf2; }
  .jn { color: var(--muted); font-size: 16px; }
  .tb { flex-basis: 100%; }
  .act { height: 30px; padding: 0 12px; background: transparent; color: var(--muted); border: 1px solid rgba(63, 208, 255, 0.22); border-radius: 4px; font: 500 13px var(--sans); cursor: pointer; }
  .act:hover { color: var(--text); border-color: var(--cyan); }
  .act[data-count]::after { content: ' · ' attr(data-count); color: var(--gold); }
  .badges, .terrain, .love { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .cap { padding: 3px 12px; background: var(--gold); color: var(--ink); font-weight: 700; font-size: 14px; }
  .pill { padding: 3px 10px; font-size: 14px; border: 1px solid rgba(63, 208, 255, 0.3); color: #d6ddf2; text-decoration: none; }
  .pill.enemy { color: var(--pink); border-color: rgba(255, 111, 168, 0.5); }
  .pill em { font-style: normal; font-size: 12px; color: var(--pink); }
  .pill.t-A, .pill.t-S { background: var(--cyan); color: var(--ink); border-color: var(--cyan); }
  .pill.t-- { color: #5d6890; }
  .k { font-size: 13px; color: var(--dim); margin-right: 6px; }
  .small { font-size: 12px; font-weight: 400; }
  .stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px 22px; }
  .stat { display: grid; gap: 3px; }
  .stat .v { font-size: 20px; font-weight: 700; }
  .to { color: var(--cyan); font-size: 16px; }
  .bar { display: flex; height: 6px; background: rgba(63, 208, 255, 0.12); }
  .bar .a { background: #e8eefc; } .bar .b { background: var(--cyan); }
  h2 { margin: 32px 0 12px; font-size: 20px; padding-left: 12px; border-left: 4px solid var(--gold); }
  .spirits { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 8px; }
  .spirits li { display: grid; gap: 2px; padding: 10px 14px; background: var(--panel); border: 1px solid var(--line-soft); }
  .skills { display: grid; gap: 22px; padding: 14px 18px 26px; background: var(--panel); border: 1px solid var(--line-soft); }
  .skill { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 16px; align-items: center; }
  .axis { position: relative; height: 2px; background: rgba(63, 208, 255, 0.3); }
  .tick { position: absolute; top: -8px; transform: translateX(-50%); display: grid; justify-items: center; }
  .tick i { width: 2px; height: 14px; background: var(--gold); }
  .tick b { font-size: 11px; font-weight: 600; color: var(--gold); margin-top: 2px; }
  .pn { display: flex; justify-content: space-between; margin-top: 28px; }
  .pn .r { margin-left: auto; }
  @media (max-width: 900px) { .side { position: static; max-width: none; max-height: 240px; } .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); } .skill { grid-template-columns: 1fr; } }
</style>
