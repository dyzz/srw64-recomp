---
// The ID tables used to be one page; they are three now (ids/[kind].astro). The old address
// sends readers to the units table, and the table's own tabs reach the other two.
import { langPaths, type Lang } from '../../../../i18n';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
return Astro.redirect(`/${lang}/mods/ids/units/`);
---
