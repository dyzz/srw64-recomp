  addLost: t('＋ 某人被击破', '+ Someone is defeated'), addTurnLimit: t('＋ 超过回合数', '+ Turn limit'),
  rulesHint: t('要给某一条配台词，在「剧情」里加一个同样时机的事件，最后一步放「胜利」或「失败」。', 'To give a rule lines, add an event with the same trigger under Story and end it with Win or Lose.'),
  arrivals: t('登场与增援', 'Arrivals'), arrivalsNote: t('每一组什么时候上场', 'when each group comes on'), unitsCount: t('{n} 个单位', '{n} units'), noUnits: t('还没有单位', 'no units yet'),
  arrivalsHint: t('选「由剧情事件叫出来」的组，要在某个事件里加一步「登场」。', 'A group “brought on by a story event” needs a Bring on step in some event.'),
  objectiveTitle: t('作战目标', 'Objective'), objectiveNote: t('地图菜单「作战目标」里显示的文字', 'what the map menu’s Objective window shows'),
  objectiveWin: t('胜利条件', 'Winning'), objectiveLose: t('失败条件', 'Losing'), objectiveAuto: t('按上面的条件自动选', 'chosen from the rules'),
  objectiveOwn: t('自己写', 'Write my own'), objectiveOwnHint: t('每句不超过 30 字。没写日文的用中文或英文那一句。', 'At most 30 characters each. Without Japanese, the Chinese or English is used.'),
  choiceOwn: t('自己写选项文字', 'Write the options myself'), choiceOptionHint: t('（不超过 24 字）', ' (24 characters at most)'), addOption: t('＋ 加一项', '+ Add an option'),
  objectiveHint: t('只能从原版用过的说法里选；它只是显示，过关与失败看上面的条件。', 'Only the original’s own wordings; they are shown only, the rules above decide.'),
  afterTitle: t('过关以后', 'Once cleared'), afterNext: t('去下一关', 'Go to a stage'), afterChoice: t('让玩家选', 'The player chooses'),
  choiceText: t('选项文本号', 'Choice text number'), choiceHint: t('只能用原版已有的选项文本（如 18402）；新写的选项文字还不支持。', 'Only a choice text the original has (18402, for one); new choice texts are not supported yet.'),
  choiceOption: t('选第 {n} 项去', 'Option {n} leads to'), stageBgm: t('战场音乐', 'Battlefield music'), stageBgmHint: t('曲目号 0–255', 'track number 0–255'),
  // Problems
  err_key: t('「{stage}」的关卡名只能用小写字母、数字、_、-', '“{stage}”: the key may use lower-case letters, digits, _ and - only'),
  err_keyTwice: t('有两关的关卡名相同：{stage}', 'Two stages share the key of “{stage}”'),
  err_next: t('「{stage}」过关后去的那一关不存在', 'The stage after “{stage}” does not exist'),
  err_noPlayer: t('「{stage}」没有我方单位', '“{stage}” has no player unit'),
  err_noEnemy: t('「{stage}」没有敌方单位，「敌方全灭」一开始就成立', '“{stage}” has no enemy unit: “no enemy left” holds from the start'),
  err_tooMany: t('「{stage}」同一阵营超过 30 个单位', '“{stage}” has more than 30 units on one side'),
  err_noWin: t('「{stage}」没有胜利条件', '“{stage}” has no way to win'),
  err_outside: t('「{stage}」的第 {n} 个单位在地图外面', 'Unit {n} of “{stage}” is off the map'),
  err_onWall: t('「{stage}」的第 {n} 个单位站在进不去的格上', 'Unit {n} of “{stage}” stands on a cell nothing can enter'),
  err_unit: t('「{stage}」的第 {n} 个单位：没有这个机体', 'Unit {n} of “{stage}”: no such unit'),
  err_pilot: t('「{stage}」的第 {n} 个单位：没有这个驾驶员', 'Unit {n} of “{stage}”: no such pilot'),
  err_sameCell: t('「{stage}」的第 {n} 个单位和同组的另一个在同一格', 'Unit {n} of “{stage}” shares its cell with another of its group'),
  err_groupNever: t('「{stage}」的第 {n} 组要由剧情事件叫出来，但没有事件让它登场', 'Group {n} of “{stage}” waits for a story event, and none brings it on'),
  err_emptyLine: t('「{stage}」有一句台词还没写', '“{stage}” has a line with nothing written'),
  err_unreached: t('没有哪一关通向「{stage}」', 'No stage leads to “{stage}”'),
  err_emptyBattleLine: t('「{stage}」有一句战斗台词没写文字或没选时机', '“{stage}” has a battle line without text or a moment'),
  err_unbalanced: t('「{stage}」有「如果／否则／如果结束」没有配对', '“{stage}” has an If, Otherwise or End if that does not pair up'),
  err_areaOutside: t('「{stage}」有一个区域超出了地图', '“{stage}” has an area off the map'),
  errRuntime: t('出错了：{detail}', 'Something went wrong: {detail}'), errNotEditors: t('这个包不是用这个编辑器导出的', 'this package was not exported by this editor'),
  game: '0.5.4',
};
const pick = pickables(lang, data.units.map((u) => u.id), data.pilots.map((p) => p.id));
const iconOf = new Map(data.units.map((u) => [u.id, u.icon]));
const units = pick.units.map((u) => ({ ...u, icon: iconOf.get(u.id) }));
const notice = versionNotice(lang, text.game);
const routes = text.routes.split('|');
---
<Base lang={lang} title={title} description={lead}>
  <div class="maker editor" data-level-editor>
    <header class="editor-head">
      <div class="editor-title">
        <span class="tag">MOD</span>
        <h1>{title}</h1>
        <span class="saved" data-saved></span>
      </div>
      <nav class="tabs" data-tabs aria-label={title}></nav>
      <div class="editor-actions">
        <span data-stage></span>
        <button type="button" class="mini" data-new>{text.newProject}</button>
        <button type="button" class="btn" data-export>{text.exportButton}</button>
      </div>
    </header>
    <p class="status export-status" data-export-status></p>
    <div class="editor-body" data-body></div>

    <div class="overview-only" data-overview-only>
      <p class="lead">{lead}</p>
      {notice && <p class="version-notice">{notice}</p>}
      <ModPackageForm lang={lang} placeholder="yourname.campaign" />
      <section class="block">
        <h2>{text.campaign}</h2>
        <div class="form">
          <label>{text.route}<select data-route>{routes.map((name, n) => <option value={n}>{name}</option>)}</select><span class="hint">{text.routeHint}</span></label>
        </div>
      </section>
      <SubmitHint lang={lang} />
    </div>
  </div>
  <script type="application/json" id="editor-data" is:inline set:html={JSON.stringify({ text, units, pilots: pick.pilots, series: pick.series, locale: langInfo(lang).tag, lang: tl(lang), game: text.game })}></script>
  <script>
    import { initLevelEditor } from '../../../scripts/level-editor';
    initLevelEditor();
  </script>
</Base>
<style is:global>
  .editor { padding: 0 clamp(12px, 2vw, 28px) 80px; }
  .editor-head { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; padding: 14px 0 0; border-bottom: 1px solid var(--line); position: sticky; top: 0; background: var(--bg); z-index: 5; }
  .editor-title { display: flex; align-items: center; gap: 10px; }
  .editor-title h1 { font-size: 20px; margin: 0; }
  .editor .saved { color: var(--green); font-size: 12.5px; }
  .editor .tabs { display: flex; flex: 1 1 auto; gap: 2px; }
  .editor .tab { font: inherit; background: none; border: 0; border-bottom: 2px solid transparent; color: var(--muted); padding: 12px 14px; cursor: pointer; }
  .editor .tab.on { color: var(--gold); border-bottom-color: var(--gold); font-weight: 600; }
  .editor-actions { display: flex; align-items: center; gap: 8px; padding-bottom: 8px; }
  .editor .export-status { margin: 6px 0 0; }
  .editor-body { display: flex; flex-wrap: wrap; gap: 18px; padding-top: 16px; align-items: flex-start; }
  .editor .rail { flex: 0 0 240px; display: flex; flex-direction: column; gap: 8px; }
  .editor .rail.wide { flex-basis: 290px; }
  .editor .center { flex: 999 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 12px; }
  .editor .center.columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); align-items: start; }
  .editor .inspector { flex: 1 1 280px; max-width: 340px; display: flex; flex-direction: column; gap: 12px; }
  .editor h2 { font-size: 18px; margin: 0; } .editor h3 { font-size: 15px; margin: 0; display: flex; align-items: baseline; gap: 8px; }
  .editor h3.good { color: var(--green); } .editor h3.bad { color: var(--pink); margin-top: 12px; }
  .editor .sub { color: var(--muted); font-size: 12px; font-weight: 400; } .editor .sub.late { color: var(--orange); }
  .editor .rail-head { display: flex; align-items: baseline; gap: 8px; font-weight: 600; }
  .editor .rail-part { color: var(--dim); font-size: 12px; letter-spacing: .08em; padding-top: 8px; }
  .editor .stage-card, .editor .flow-node { font: inherit; flex: 0 0 auto; text-align: left; display: grid; gap: 2px; padding: 8px 10px; min-height: 48px; background: transparent; color: var(--text); border: 1px solid var(--line); border-radius: 4px; cursor: pointer; }
  .editor .stage-card.on, .editor .flow-node.on { border-color: var(--gold); background: #16204a; }
  .editor .stage-card strong { display: flex; align-items: center; gap: 8px; } .editor .count { margin-left: auto; }
  .editor .side-dot { width: 10px; height: 10px; border-radius: 2px; flex: 0 0 auto; display: inline-block; }
  .editor .add { font: inherit; min-height: 44px; background: transparent; border: 1px dashed var(--line); border-radius: 4px; color: var(--cyan); cursor: pointer; }
  .editor .mini.danger { color: var(--pink); } .editor .mini:disabled { opacity: .4; }
  .editor .mini.file { cursor: pointer; display: inline-flex; align-items: center; }
  .editor .row { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
  .editor .grid2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .editor .grid3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; margin-bottom: 8px; }
  .editor .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px; }
  .editor .panel, .editor .step { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 14px; display: flex; flex-direction: column; gap: 10px; }
  .editor .dot { width: 22px; height: 22px; border-radius: 50%; background: var(--gold); color: var(--ink); font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
  .editor .dot.done { background: var(--green); }
  .editor .flow-box { overflow: auto; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; }
  .editor .flow { position: relative; } .editor .flow svg { position: absolute; inset: 0; }
  .editor .flow-node { position: absolute; background: #121a3c; align-content: center; }
  .editor .flow-end { position: absolute; padding: 4px 12px; border: 1px solid var(--green); border-radius: 16px; color: var(--green); font-size: 13px; }
  .editor .problem { display: flex; gap: 8px; margin: 0; } .editor .problem span { color: var(--orange); font-weight: 700; }
  .editor .problem.hard span { color: var(--pink); } .editor .problem.ok span { color: var(--green); }
  .editor .toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; } .editor .spacer { flex: 1 1 auto; }
  .editor .segment { display: flex; gap: 4px; padding: 4px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; }
  .editor .seg { font: inherit; min-height: 36px; padding: 0 12px; background: transparent; color: var(--text); border: 1px solid transparent; border-radius: 4px; cursor: pointer; }
  .editor .seg.on { color: var(--gold); border-color: var(--gold); background: #16204a; }
  .editor .zoom, .editor .check { display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--muted); }
  .editor .scroll { max-height: 74vh; overflow: auto; border: 1px solid var(--line); border-radius: 6px; background: #05070f; margin-top: 8px; }
  .editor canvas { display: block; cursor: crosshair; }
  .editor .hover { min-height: 1.4em; margin: 6px 0 0; }
  .editor .brushes { display: flex; flex-direction: column; gap: 6px; max-height: 46vh; overflow: auto; padding-right: 4px; }
  .editor .brush { font: inherit; flex: 0 0 auto; display: flex; align-items: center; gap: 10px; min-height: 48px; padding: 6px 10px; background: transparent; color: var(--text); border: 1px solid var(--line); border-radius: 4px; cursor: pointer; text-align: left; }
  .editor .brush.on { border-color: var(--gold); background: #16204a; }
  .editor .swatch { width: 22px; height: 22px; border-radius: 3px; flex: 0 0 auto; } .editor .brush-name { flex: 1; display: grid; }
  .editor .faces img, .editor .faces .blank, .editor .say img, .editor .say .blank, .editor .game-line img, .editor .game-line .blank { width: 64px; height: 64px; object-fit: cover; border-radius: 4px; border: 1px solid var(--line); background: #121a3c; flex: 0 0 auto; display: block; }
  .editor .pick-button { font: inherit; min-height: 40px; padding: 0 10px; background: var(--bg); color: var(--text); border: 1px solid var(--line); border-radius: 4px; cursor: pointer; text-align: left; }
  .editor .num-in { width: 5.5em; } .editor .op-in { width: 6em; font-family: var(--mono); } .editor .static { padding: 8px 0; }
  .editor .title-in { flex: 1 1 240px; font-size: 18px; font-weight: 600; }
  .editor .when-box { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 10px 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; }
  .editor .when { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; flex: 1 1 auto; }
  .editor .step-row { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; background: var(--panel); border: 1px solid var(--line); border-radius: 6px; }
  .editor .step-row.on { border-color: var(--gold); }
  .editor .step-n { color: var(--dim); width: 18px; padding-top: 8px; }
  .editor .step-kind { padding: 3px 8px; border-radius: 3px; background: #1d2a5c; color: var(--cyan); font-size: 12px; margin-top: 6px; white-space: nowrap; }
  .editor .k-say .step-kind { background: #3a3210; color: var(--gold); } .editor .k-deploy .step-kind, .editor .k-leave .step-kind { background: #4a1d2a; color: #ff9aa6; }
  .editor .k-win .step-kind, .editor .k-join .step-kind { background: #12382a; color: var(--green); } .editor .k-lose .step-kind { background: #4a1d2a; color: var(--pink); }
  .editor .step-body { flex: 1; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; min-width: 0; }
  .editor .say { display: flex; gap: 10px; flex: 1; min-width: 0; } .editor .say img, .editor .say .blank { width: 56px; height: 56px; }
  .editor .say-body { flex: 1; display: grid; gap: 6px; min-width: 0; } .editor .say textarea { width: 100%; font-size: 15px; line-height: 1.6; }
  .editor .langs-done { margin-left: auto; }
  .editor .step-tools { display: flex; gap: 2px; }
  .editor .icon { font: inherit; min-width: 36px; min-height: 36px; background: transparent; color: var(--muted); border: 0; border-radius: 4px; cursor: pointer; } .editor .icon:disabled { opacity: .3; }
  .editor .add-step { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 10px 12px; border: 1px dashed var(--line); border-radius: 6px; }
  .editor .chip { font: inherit; min-height: 34px; padding: 0 12px; background: #121a3c; color: var(--cyan); border: 1px solid var(--line); border-radius: 18px; cursor: pointer; }
  .editor .game-box { background: #1c2a1a; border: 1px solid var(--line); border-radius: 6px; padding: 12px; min-height: 150px; display: flex; flex-direction: column; justify-content: flex-end; }
  .editor .game-line { display: flex; gap: 8px; align-items: flex-end; }
  .editor .game-text { flex: 1; display: grid; gap: 2px; background: rgba(8, 12, 40, .88); border: 2px solid #9fb0e8; border-radius: 4px; padding: 8px 10px; font-size: 15px; line-height: 1.5; white-space: pre-wrap; }
  .editor .game-name { color: #6fb8ff; font-size: 12px; }
  .editor .rule { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 8px 10px; background: #121a3c; border: 1px solid var(--line); border-radius: 6px; }
  .editor .rule-name { min-width: 6em; }
  .editor .overview-only { max-width: var(--max); margin-top: 28px; } .editor .lead { color: var(--muted); }
  .editor .pick-dialog { width: min(920px, 94vw); max-height: 86vh; background: var(--panel); color: var(--text); border: 1px solid var(--line); border-radius: 8px; padding: 16px; }
  .editor .pick-dialog::backdrop { background: rgba(0, 0, 0, .6); }
  .editor .pick-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
  @media (max-width: 900px) { .editor .rail, .editor .rail.wide, .editor .inspector { flex: 1 1 100%; max-width: none; } }
</style>
