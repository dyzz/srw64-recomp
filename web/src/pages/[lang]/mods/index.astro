---
// MOD downloads: the packages this site hosts itself (web/scripts/export_mods.py packs them
// into public/mods and writes src/data/mods/<id>.json). Other people's packages will be
// listed from their GitHub Releases (docs/design/mod-packages.md §13) once submissions open.
import Base from '../../../layouts/Base.astro';
import { UI, langPaths, listSep, tl, type Lang } from '../../../i18n';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
type Text = { ja?: string; 'zh-Hans'?: string; en?: string; ko?: string };
type Mod = {
  id: string; version: string; name: Text; description?: Text; authors: string[]; license: string; game: string;
  contents: string[]; languages?: string[]; file: string; bytes: number; sha256: string; url: string; source: string; published: string | null;
  netdisk?: { quark?: string; baidu?: string }; community?: boolean;
};
const mods = Object.values(import.meta.glob<Mod>('../../../data/mods/*.json', { eager: true, import: 'default' }))
  .sort((a, b) => a.id.localeCompare(b.id));
const loc = { zh: 'zh-Hans', en: 'en', ja: 'ja', ko: 'ko' }[tl(lang)] as keyof Text;
const pick = (t: Text | undefined) => (t ? t[loc] ?? t.en ?? t.ja ?? '' : '');
const t = {
  title: { zh: 'MOD 下载', en: 'Mod downloads', ja: 'MOD ダウンロード', ko: 'MOD 다운로드' },
  lead: {
    zh: '我们自己做的 MOD 包，可以直接从这里下载。把下载的 .srw64mod 文件拖进游戏窗口就会安装，在 MOD 管理里可以停用或删除。安卓版放进「文件」里 Marchwind64 文件夹的 mods/，或在 MOD 页点「从文件安装」。',
    en: 'Mod packages we made ourselves, to download here. Drop the .srw64mod file on the game window to install it; the MOD manager disables or removes it. On Android, put it in mods/ inside the Marchwind64 folder under Documents, or press Install from file on the MOD page.',
    ja: '私たちが作った MOD パッケージを、ここからダウンロードできます。.srw64mod ファイルをゲームのウィンドウにドラッグするとインストールされ、MOD 管理で無効化や削除ができます。Android 版では「ファイル」アプリの Marchwind64 フォルダー内 mods/ に置くか、MOD ページの「ファイルからインストール」を使います。',
    ko: '제가 직접 만든 MOD 패키지를 여기서 다운로드할 수 있습니다. .srw64mod 파일을 게임 창에 끌어다 놓으면 설치되고, MOD 관리에서 비활성화하거나 삭제할 수 있습니다. Android에서는 Documents 아래 Marchwind64 폴더 안의 mods/에 넣거나, MOD 화면에서 “파일에서 설치”를 누르세요.',
  },
  android: { zh: '安卓版怎么安装（图解）', en: 'Installing on Android (illustrated)', ja: 'Android 版でのインストール（図解）', ko: 'Android에서 설치하는 방법 (그림 설명)' },
  androidAlt: {
    zh: '安卓版安装 MOD：设置 › 通用 › MOD，再点「从文件安装」选文件，或把文件放进 Documents/Marchwind64/mods',
    en: 'Installing a MOD on Android: Settings › General › MOD, then Install from file, or put the file in Documents/Marchwind64/mods',
    ja: 'Android 版で MOD をインストール：設定 › 一般 › MOD を開き、「ファイルからインストール」で選ぶか、Documents/Marchwind64/mods に置く',
    ko: 'Android에서 MOD 설치: 설정 › 일반 › MOD를 연 뒤 “파일에서 설치”로 파일을 선택하거나, 파일을 Documents/Marchwind64/mods에 넣습니다',
  },
  shareTitle: { zh: '投稿到官网', en: 'Submit to the site', ja: '公式サイトに投稿', ko: '공식 사이트에 제출' },
  shareLead: {
    zh: '做好的包可以列到这个页面，让大家下载。投稿走 GitHub。',
    en: 'A finished package can be listed on this page for everyone to download. Submitting happens on GitHub.',
    ja: '完成したパッケージをこのページに掲載して、みんなにダウンロードしてもらえます。投稿は GitHub で行います。',
    ko: '완성한 패키지를 이 페이지에 올려 누구나 다운로드하게 할 수 있습니다. 제출은 GitHub에서 합니다.',
  },
  makeTitle: { zh: '自己做 MOD', en: 'Make your own', ja: '自分で作る', ko: '직접 만들기' },
  discTitle: {
    zh: '用自己的光盘做战斗语音',
    en: 'Battle voices from your own discs',
    ja: '自分のディスクから戦闘ボイスを作る',
    ko: '내 디스크로 전투 음성 만들기',
  },
  discLead: {
    zh: '这个工具读你自己的光盘镜像，从后来几作有语音的超级机器人大战里，找出同一角色说同一句的语音，生成 .srw64mod。支持 17 款游戏，有一款就能用，全部齐备时约七成半的战斗台词有语音。需要 Python。生成的包只供自己使用，请不要分发。',
    en: 'This tool reads your own disc images of later, voiced Super Robot Taisen games, finds where the same character says the same line, and builds a .srw64mod. It supports 17 games; any one is enough, and all of them voice about three quarters of the battle lines. It needs Python. The package you build is for your own use; please do not share it.',
    ja: '後年のボイス付きスーパーロボット大戦のディスクイメージ（ご自身のもの）を読み込み、同じキャラクターが同じセリフを話している音声を探して .srw64mod を作るツールです。対応は 17 作品で、1 作品からでも使えます。全部そろえると戦闘セリフの約 4 分の 3 に音声が付きます。Python が必要です。作ったパッケージは個人での利用に限り、配布しないでください。',
    ko: '음성이 있는 후속 슈퍼로봇대전의 디스크 이미지(직접 가지고 있는 것)를 읽어, 같은 캐릭터가 같은 대사를 말하는 음성을 찾아 .srw64mod를 만드는 도구입니다. 17개 게임을 지원하며 한 개만 있어도 쓸 수 있고, 모두 갖추면 전투 대사의 약 4분의 3에 음성이 붙습니다. Python이 필요합니다. 만든 패키지는 개인적으로만 사용하고 배포하지 말아 주세요.',
  },
  discLink: { zh: '制作工具（GitHub）', en: 'Get the tool (GitHub)', ja: 'ツール（GitHub）', ko: '도구 (GitHub)' },
  toolsLead: {
    zh: '在浏览器里选好内容，导出 .srw64mod，拖进游戏窗口就能安装。',
    en: 'Choose what to change in your browser, export a .srw64mod and drop it on the game window.',
    ja: 'ブラウザーで内容を選び、.srw64mod を書き出してゲームのウィンドウにドラッグします。',
    ko: '브라우저에서 내용을 고르고 .srw64mod로 내보낸 뒤 게임 창에 끌어다 놓으세요.',
  },
  docsLead: {
    zh: '想手工写包，或做剧情、战役和语言包，先看「安装与制作」。',
    en: 'To write a package by hand, or make story, campaign or language mods, start with Installing and making.',
    ja: 'パッケージを手で書く場合や、シナリオ・キャンペーン・言語の MOD を作る場合は、まず「インストールと制作」をご覧ください。',
    ko: '패키지를 직접 작성하거나 스토리, 캠페인, 언어 MOD를 만들려면 먼저 “설치와 제작”을 읽어 보세요.',
  },
  story: { zh: '剧情', en: 'Story', ja: 'シナリオ', ko: '스토리' },
  campaign: { zh: '追加剧本', en: 'Campaigns', ja: '追加シナリオ', ko: '캠페인' },
  language: { zh: '语言包', en: 'Language packages', ja: '言語パッケージ', ko: '언어 패키지' },
  community: { zh: '社区投稿', en: 'Community', ja: 'コミュニティ投稿', ko: '커뮤니티 제출' },
  communityNote: {
    zh: '只做过校验，没有逐项实测。',
    en: 'Checked automatically, not tested item by item.',
    ja: '自動チェックのみで、項目ごとの実機確認はしていません。',
    ko: '자동 검사만 거쳤으며, 항목별 실제 테스트는 하지 않았습니다.',
  },
  download: { zh: '下载', en: 'Download', ja: 'ダウンロード', ko: '다운로드' },
  version: { zh: '版本', en: 'Version', ja: 'バージョン', ko: '버전' },
  game: { zh: '需要游戏', en: 'Needs the game', ja: '対応ゲーム', ko: '필요한 게임' },
  authors: { zh: '作者', en: 'Authors', ja: '作者', ko: '작성자' },
  license: { zh: '许可', en: 'License', ja: 'ライセンス', ko: '라이선스' },
  updated: { zh: '更新', en: 'Updated', ja: '更新', ko: '업데이트' },
  contents: { zh: '内容', en: 'Contents', ja: '内容', ko: '내용' },
  languages: { zh: '增加语言', en: 'Adds languages', ja: '追加する言語', ko: '추가 언어' },
  source: { zh: '源文件（GitHub）', en: 'Source (GitHub)', ja: 'ソース（GitHub）', ko: '소스 (GitHub)' },
  release: { zh: '发布页（GitHub）', en: 'Release page (GitHub)', ja: 'リリースページ（GitHub）', ko: '릴리스 페이지 (GitHub)' },
  mirrors: { zh: '网盘（在 MOD 文件夹里）：', en: 'Net disks (in the MOD folder): ', ja: 'ネットディスク（MOD フォルダー内）：', ko: '클라우드 드라이브 (MOD 폴더 안): ' },
  quark: { zh: '夸克', en: 'Quark', ja: 'Quark', ko: 'Quark' },
  baidu: { zh: '百度', en: 'Baidu', ja: 'Baidu', ko: 'Baidu' },
  checksum: { zh: '校验', en: 'Checksum', ja: 'チェックサム', ko: '체크섬' },
  none: { zh: '还没有可以下载的包。', en: 'No packages yet.', ja: 'まだパッケージはありません。', ko: '아직 다운로드할 수 있는 패키지가 없습니다.' },
};
const l = tl(lang);
const tools = [
  { href: 'mods/bgm/', label: UI.nav.modBgm[l] },
  { href: 'mods/voices/', label: UI.nav.modVoicesMaker[l] },
  { href: 'mods/data/', label: UI.nav.modDataMaker[l] },
  { href: 'mods/names/', label: UI.nav.modNamesMaker[l] },
  { href: 'mods/icons/', label: UI.nav.modIconsMaker[l] },
];
const guides = [
  { href: 'docs/mods/', label: UI.nav.modPackages[l] },
  { href: 'docs/mod-music/', label: UI.nav.modMusic[l] },
  { href: 'docs/mod-data/', label: UI.nav.modData[l] },
  { href: 'docs/mod-names/', label: UI.nav.modNames[l] },
  { href: 'docs/mod-story/', label: t.story[l] },
  { href: 'docs/mod-campaign/', label: t.campaign[l] },
  { href: 'docs/mod-language/', label: t.language[l] },
  { href: 'mods/ids/', label: UI.nav.modIds[l] },
];
const kinds: Record<string, { zh: string; en: string; ja: string; ko: string }> = {
  data: { zh: '数值', en: 'Numbers', ja: '数値', ko: '수치' },
  audio: { zh: '声音', en: 'Sound', ja: 'サウンド', ko: '사운드' },
  campaign: { zh: '战役', en: 'Campaign', ja: 'キャンペーン', ko: '캠페인' },
  art: { zh: '图片', en: 'Art', ja: '画像', ko: '그래픽' },
  dialogue: { zh: '台词与文字', en: 'Dialogue and text', ja: 'セリフと文字', ko: '대사와 텍스트' },
  story: { zh: '剧情', en: 'Story', ja: 'ストーリー', ko: '스토리' },
};
// ">=0.5.1" as words; anything else as written.
const needs = (req: string) => {
  const m = /^>=\s*([\d.]+)$/.exec(req.trim());
  if (!m) return req === '*' ? { zh: '任意版本', en: 'Any version', ja: '全バージョン', ko: '모든 버전' }[tl(lang)] : req;
  return { zh: `${m[1]} 或更新`, en: `${m[1]} or later`, ja: `${m[1]} 以降`, ko: `${m[1]} 이상` }[tl(lang)];
};
const size = (n: number) =>
  n < 1024 ? `${n} B` : n < 1024 * 1024 ? `${(n / 1024).toFixed(1)} KB` : `${(n / 1024 / 1024).toFixed(1)} MB`;
---
<Base lang={lang} title={t.title[tl(lang)]} description={t.lead[tl(lang)]}>
  <div class="wrap mods">
    <header class="page-head">
      <span class="tag">MOD</span>
      <h1>{t.title[tl(lang)]}</h1>
      <p>{t.lead[tl(lang)]}</p>
      <details class="android">
        <summary>{t.android[tl(lang)]}</summary>
        <img src={`/media/android-mod-install-${lang === 'ko' ? 'en' : tl(lang)}.webp`} alt={t.androidAlt[tl(lang)]} width="1600" height={{ zh: 1678, en: 1698, ja: 1720, ko: 1698 }[tl(lang)]} loading="lazy" />
      </details>
    </header>
    <section class="make" aria-labelledby="make-title">
      <h2 id="make-title">{t.makeTitle[tl(lang)]}</h2>
      <div class="routes">
        <div class="route">
          <h3>{UI.nav.modGroupTools[tl(lang)]}</h3>
          <p>{t.toolsLead[tl(lang)]}</p>
          <ul>{tools.map((m) => <li><a href={`/${lang}/${m.href}`}><img src="/brand/maker.svg" width="16" height="16" alt="" />{m.label}</a></li>)}</ul>
        </div>
        <div class="route">
          <h3>{UI.nav.modGroupDocs[tl(lang)]}</h3>
          <p>{t.docsLead[tl(lang)]}</p>
          <ul>{guides.map((m) => <li><a href={`/${lang}/${m.href}`}>{m.label}</a></li>)}</ul>
        </div>
        <div class="route share">
          <h3>{t.shareTitle[l]}</h3>
          <p>{t.shareLead[l]}</p>
          <a class="btn" href={`/${lang}/mods/submit/`}>{UI.nav.modSubmit[l]}</a>
        </div>
        <div class="route disc">
          <div>
            <h3>{t.discTitle[l]}</h3>
            <p>{t.discLead[l]}</p>
          </div>
          <a class="btn" href="https://github.com/dyzz/srw64-recomp-disc-voice-mod" rel="noopener">{t.discLink[l]}</a>
        </div>
      </div>
    </section>
    {mods.length === 0 && <p class="note">{t.none[tl(lang)]}</p>}
    <ul class="list">
      {mods.map((m) => (
        <li class="card" id={m.id}>
          <div class="head">
            <div>
              <h2>{pick(m.name)}</h2>
              <code class="id">{m.id}</code>
              {m.community && <p class="community"><span class="tag cyan">{t.community[tl(lang)]}</span> {t.communityNote[tl(lang)]}</p>}
            </div>
            <a class="btn" href={m.url} download={m.file}>{t.download[tl(lang)]}<small>{m.file} · {size(m.bytes)}</small></a>
          </div>
          {m.description && <p class="desc">{pick(m.description)}</p>}
          <dl>
            <div><dt>{t.version[tl(lang)]}</dt><dd class="latin">{m.version}</dd></div>
            <div><dt>{t.game[tl(lang)]}</dt><dd>{needs(m.game)}</dd></div>
            <div><dt>{t.contents[tl(lang)]}</dt><dd>{m.contents.map((c) => kinds[c]?.[tl(lang)] ?? c).join(listSep(lang))}</dd></div>
            {m.languages?.length ? <div><dt>{t.languages[tl(lang)]}</dt><dd>{m.languages.join(', ')}</dd></div> : null}
            <div><dt>{t.authors[tl(lang)]}</dt><dd>{m.authors.join(', ')}</dd></div>
            <div><dt>{t.license[tl(lang)]}</dt><dd class="latin">{m.license}</dd></div>
            {m.published && <div><dt>{t.updated[tl(lang)]}</dt><dd class="latin">{m.published}</dd></div>}
          </dl>
          {l === 'zh' && m.netdisk && (m.netdisk.quark || m.netdisk.baidu) && (
            <p class="foot">{t.mirrors[tl(lang)]}{(['quark', 'baidu'] as const).filter((k) => m.netdisk?.[k]).map((k, i) => <>{i > 0 && ' · '}<a href={m.netdisk?.[k]}>{t[k][tl(lang)]}</a></>)}</p>
          )}
          <p class="foot"><span class="k">{t.checksum[tl(lang)]}</span> <code class="sha">SHA-256 {m.sha256}</code> · <a href={m.source}>{m.source.includes('/releases/') ? t.release[tl(lang)] : t.source[tl(lang)]}</a></p>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .mods { padding-bottom: 64px; }
  .note { color: var(--muted); font-size: 14px; }
  .android { margin: 0 0 12px; }
  .android summary { cursor: pointer; color: var(--gold); font-size: 14px; }
  .android img { display: block; width: 100%; max-width: 720px; height: auto; margin-top: 12px; }
  .make { margin: 0 0 28px; }
  .make h2 { margin: 0 0 12px; font-size: 20px; }
  .routes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .route { padding: 16px 18px; background: var(--panel); border: 1px solid var(--line-soft); }
  .route h3 { margin: 0 0 6px; font-size: 16px; }
  .route p { margin: 0 0 12px; color: var(--muted); font-size: 14px; line-height: 1.6; }
  .route ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; }
  .route ul a { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; }
  .share { border-color: var(--gold); }
  .disc { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .disc p { margin: 0; }
  .disc .btn { flex: none; text-align: center; }
  @media (max-width: 760px) { .disc { flex-direction: column; align-items: flex-start; gap: 12px; } }
  @media (max-width: 1000px) { .routes { grid-template-columns: repeat(2, minmax(0, 1fr)); } .share { grid-column: 1 / -1; } }
  @media (max-width: 760px) { .routes { grid-template-columns: minmax(0, 1fr); } }
  .list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  .card { padding: 20px 22px; background: var(--panel); border: 1px solid var(--line-soft); display: grid; gap: 14px; scroll-margin-top: 80px; }
  .card:target { border-color: var(--gold); }
  .head { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
  .head h2 { margin: 0 0 4px; font-size: 22px; }
  .id { color: var(--muted); font-size: 13px; }
  .community { margin: 8px 0 0; color: var(--muted); font-size: 13px; }
  .head .btn { text-align: center; }
  .desc { margin: 0; line-height: 1.7; }
  dl { margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px 20px; }
  dt { color: var(--muted); font-size: 13px; }
  dd { margin: 2px 0 0; }
  .foot { margin: 0; color: var(--muted); font-size: 13px; overflow-wrap: anywhere; }
  .foot .k { margin-right: 4px; }
  .sha { font-size: 12px; }
</style>
