---
// The number MOD maker (docs/design/mod-names-art-data.md §2.3): change units, pilots and
// weapons field by field against the original values and export data/*.json in a package,
// all in the browser (scripts/data-maker.ts). The values are export_data_tables.py's.
import Base from '../../../layouts/Base.astro';
import ModPackageForm from '../../../components/ModPackageForm.astro';
import { langInfo, langPaths, tl, type Lang } from '../../../i18n';
import { packageText, versionNotice } from '../../../lib/mod-maker-text';
import { pickables } from '../../../lib/mod-picker';
import data from '../../../data/data-mods.json';
import '../../../styles/mod-maker.css';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const L = <T,>(v: { zh: T; en: T; ja: T }) => v[tl(lang)];
const title = { zh: '数值 MOD 制作', en: 'Number mod maker', ja: '数値 MOD メーカー' };
const lead = {
  zh: '挑机体、人物或武器，改 HP、装甲、能力值、地形适应、特殊能力、技能、精神、武器威力和射程，导出 .srw64mod 拖进游戏窗口即可安装。每一项旁边都有原版的值，只有改过的会写进包里。',
  en: 'Pick units, pilots or weapons and change HP, armor, stats, terrain ranks, abilities, skills, spirits, weapon power and range; drag the exported .srw64mod into the game window to install it. Each field shows the original value, and only what you change goes into the package.',
  ja: 'ユニット・キャラクター・武器を選んで、HP・装甲・能力値・地形適応・特殊能力・技能・精神・武器の攻撃力や射程を変え、書き出した .srw64mod をゲームのウィンドウにドラッグしてインストールします。各項目に原作の値が出ており、変えた項目だけがパッケージに入ります。',
};
const terrain = L({ zh: ['空', '陆', '海', '宇'], en: ['Air', 'Land', 'Sea', 'Space'], ja: ['空', '陸', '海', '宇'] });
const text = {
  ...packageText(lang),
  units: L({ zh: '机体', en: 'Units', ja: 'ユニット' }),
  pilots: L({ zh: '人物', en: 'Pilots', ja: 'キャラクター' }),
  weapons: L({ zh: '武器', en: 'Weapons', ja: '武器' }),
  allSeries: L({ zh: '全部作品', en: 'All series', ja: 'すべての作品' }),
  pickUnitFirst: L({ zh: '先选机体，再选它的武器。', en: 'Pick a unit, then one of its weapons.', ja: 'ユニットを選んでから、その武器を選んでください。' }),
  weaponsOf: L({ zh: '{unit} 的武器', en: 'Weapons of {unit}', ja: '{unit} の武器' }),
  findWeapon: L({ zh: '或直接按武器名、编号查找', en: 'Or find a weapon by name or number', ja: 'または武器名・番号で検索' }),
  unitWeapons: L({ zh: '这台机体的武器', en: 'This unit’s weapons', ja: 'このユニットの武器' }),
  abilityMany: L({ zh: '原版状态页的特殊能力一栏只放得下约 3 个，再多会挤（本移植版的页面会缩小字号）。', en: 'The original status screen fits about 3 abilities; more get cramped (this port’s pages shrink the text).', ja: '原作のステータス画面の特殊能力欄は 3 個ほどしか入りません。それ以上は窮屈になります（この移植版の画面は文字を縮めます）。' }),
  abilityRules: L({ zh: '分身、马赫特技、真·马赫特技、神之影、盖塔幻影、瞬幻足、超级干扰器都走同一个 50% 闪避判定，带几个都不叠加；光束涂层、I 力场、行星防御器的护罩值相加（1000、2000、2000）；奥拉屏障单独判定。HP 回复 10% 和 20% 只能选一个。', en: 'Afterimage, Mach Special, Shin Mach Special, God Shadow, Getter Vision, Phantom Step and Hyper Jammer share one 50% dodge; having several does not stack. Beam Coat, I-Field and Planet Defensor add their barriers (1000, 2000, 2000); Aura Barrier is judged on its own. Choose one of HP Regen 10% and 20%.', ja: '分身・マッハスペシャル・真マッハスペシャル・ゴッドシャドー・ゲッタービジョン・瞬幻足・ハイパージャマーは同じ 50% の回避判定で、複数あっても重なりません。ビームコート・Iフィールド・プラネイトディフェンサーはバリア値が加算されます（1000・2000・2000）。オーラバリアは別に判定されます。HP回復 10% と 20% はどちらか一つです。' }),
  edited: L({ zh: '已改动', en: 'Changed', ja: '変更済み' }),
  editedNone: L({ zh: '还没有改动。在上面查找并选中一项开始改。', en: 'Nothing changed yet. Search above and pick an entry.', ja: 'まだ変更はありません。上で検索して項目を選んでください。' }),
  errEmpty: L({ zh: '还没有改动任何数值', en: 'Nothing is changed yet', ja: 'まだ何も変えていません' }),
  shared: L({ zh: '共用这条能力记录，会一起变：', en: 'Share this record and change with it: ', ja: 'この記録を共有し、一緒に変わります：' }),
  carriers: L({ zh: '带这件武器的机体，会一起变：', en: 'Units carrying it, which all change: ', ja: 'この武器を持つユニット（全員分変わります）：' }),
  noRecord: L({ zh: '这个人物没有能力记录，不能改数值', en: 'This pilot has no ability record to change', ja: 'このキャラクターには能力記録がありません' }),
  terrain: L({ zh: '地形适应', en: 'Terrain', ja: '地形適応' }),
  abilities: L({ zh: '特殊能力', en: 'Abilities', ja: '特殊能力' }),
  skills: L({ zh: '技能（习得等级，用逗号分隔；空着就是没有）', en: 'Skills (levels learned, comma-separated; empty for none)', ja: '技能（習得レベルをカンマ区切り。空なら無し）' }),
  skillRow: L({ zh: 'NT、强化人、圣战士、超能力、底力只能有一个', en: 'One of Newtype, Enhanced, Holy Warrior, ESP and Potential at most', ja: 'NT・強化・聖戦士・超能力・底力はどれか一つまで' }),
  spirits: L({ zh: '精神（最多 6 个，习得等级从小到大）', en: 'Spirits (up to 6, levels ascending)', ja: '精神（最大 6 個、習得レベルは小さい順）' }),
  size: L({ zh: '尺寸', en: 'Size', ja: 'サイズ' }),
  equipment: L({ zh: '装备', en: 'Equipment', ja: '装備' }),
  shield: L({ zh: '盾', en: 'Shield', ja: '盾' }),
  sword: L({ zh: '剑', en: 'Sword', ja: '剣' }),
  stats1: L({ zh: '能力值是 1 级的值，之后每级照原版成长。', en: 'Stats are level-1 values; each level adds the original growth.', ja: '能力値はレベル 1 の値で、以後は原作どおり成長します。' }),
  power100: L({ zh: '威力要是 100 的倍数', en: 'Power must be a multiple of 100', ja: '攻撃力は 100 の倍数です' }),
  rangeOrder: L({ zh: '最小射程不能大于最大射程', en: 'Minimum range cannot exceed maximum range', ja: '最小射程は最大射程以下です' }),
  outOfRange: L({ zh: '{field} 要在 {low}–{high} 之间', en: '{field} must be {low}–{high}', ja: '{field} は {low}〜{high} です' }),
  skillBad: L({ zh: '{skill}：等级要是 1–99、从小到大、最多 9 个', en: '{skill}: levels 1–99, ascending, at most 9', ja: '{skill}：レベルは 1〜99、小さい順、最大 9 個' }),
  skillOne: L({ zh: 'NT、强化人、圣战士、超能力、底力只能留一个', en: 'Keep only one of Newtype, Enhanced, Holy Warrior, ESP and Potential', ja: 'NT・強化・聖戦士・超能力・底力は一つだけにしてください' }),
  spiritBad: L({ zh: '精神的习得等级要是 1–99、从小到大', en: 'Spirit levels must be 1–99, ascending', ja: '精神の習得レベルは 1〜99、小さい順です' }),
  fixFirst: L({ zh: '先改正这些：', en: 'Fix these first: ', ja: '先に直してください：' }),
  level: L({ zh: '等级', en: 'Level', ja: 'レベル' }),
  terrainNames: terrain,
  game: '0.5.2',
};
const fields = {
  units: [
    { key: 'hp', label: 'HP', low: 1, high: 65535 }, { key: 'en', label: 'EN', low: 0, high: 65535 },
    { key: 'move', label: L({ zh: '移动力', en: 'Move', ja: '移動力' }), low: 1, high: 30 },
    { key: 'mobility', label: L({ zh: '运动性', en: 'Mobility', ja: '運動性' }), low: 0, high: 65535 },
    { key: 'armor', label: L({ zh: '装甲', en: 'Armor', ja: '装甲' }), low: 0, high: 65535 },
    { key: 'limit', label: L({ zh: '限界', en: 'Limit', ja: '限界' }), low: 0, high: 65535 },
    { key: 'repair_cost', label: L({ zh: '修理费', en: 'Repair cost', ja: '修理費' }), low: 0, high: 65535 },
    { key: 'upgrade_cap', label: L({ zh: '改造上限', en: 'Upgrade limit', ja: '改造上限' }), low: 0, high: 15 },
    { key: 'parts_slots', label: L({ zh: '部件槽', en: 'Part slots', ja: 'パーツスロット' }), low: 0, high: 4 },
  ],
  pilots: [
    { key: 'melee', label: L({ zh: '格斗', en: 'Melee', ja: '格闘' }), low: 0, high: 255 },
    { key: 'ranged', label: L({ zh: '射击', en: 'Ranged', ja: '射撃' }), low: 0, high: 255 },
    { key: 'evade', label: L({ zh: '回避', en: 'Evade', ja: '回避' }), low: 0, high: 255 },
    { key: 'hit', label: L({ zh: '命中', en: 'Hit', ja: '命中' }), low: 0, high: 255 },
    { key: 'reaction', label: L({ zh: '反应', en: 'Reaction', ja: '反応' }), low: 0, high: 255 },
    { key: 'skill', label: L({ zh: '技量', en: 'Skill', ja: '技量' }), low: 0, high: 255 },
    { key: 'sp', label: 'SP', low: 0, high: 255 },
    { key: 'double_move', label: L({ zh: '再动等级', en: 'Double move level', ja: '再動レベル' }), low: 0, high: 99 },
  ],
  weapons: [
    { key: 'power', label: L({ zh: '威力', en: 'Power', ja: '攻撃力' }), low: 0, high: 25500, step: 100 },
    { key: 'range_min', label: L({ zh: '最小射程', en: 'Min range', ja: '最小射程' }), low: 0, high: 30 },
    { key: 'range_max', label: L({ zh: '最大射程', en: 'Max range', ja: '最大射程' }), low: 1, high: 30 },
    { key: 'hit', label: L({ zh: '命中修正', en: 'Hit', ja: '命中補正' }), low: -128, high: 127 },
    { key: 'critical', label: L({ zh: '暴击修正', en: 'Critical', ja: 'クリティカル補正' }), low: -128, high: 127 },
    { key: 'ammo', label: L({ zh: '弹数（-1 不用弹数）', en: 'Ammo (-1 none)', ja: '弾数（-1 で無し）' }), low: -1, high: 99 },
    { key: 'en', label: L({ zh: '消耗 EN', en: 'EN cost', ja: '消費 EN' }), low: 0, high: 255 },
    { key: 'morale', label: L({ zh: '需要气力', en: 'Morale', ja: '必要気力' }), low: 0, high: 255 },
  ],
};
const abilities = [
  ['beam_coat', { zh: '光束涂层', en: 'Beam Coat', ja: 'ビームコート' }], ['i_field', { zh: 'I 力场', en: 'I-Field', ja: 'Iフィールド' }],
  ['planet_defensor', { zh: '行星防御器', en: 'Planet Defensor', ja: 'プラネイトディフェンサー' }], ['aura_barrier', { zh: '奥拉屏障', en: 'Aura Barrier', ja: 'オーラバリア' }],
  ['afterimage', { zh: '分身', en: 'Afterimage', ja: '分身' }], ['mach_special', { zh: '马赫特技', en: 'Mach Special', ja: 'マッハスペシャル' }],
  ['true_mach_special', { zh: '真·马赫特技', en: 'Shin Mach Special', ja: '真マッハスペシャル' }], ['god_shadow', { zh: '神之影', en: 'God Shadow', ja: 'ゴッドシャドー' }],
  ['getter_vision', { zh: '盖塔幻影', en: 'Getter Vision', ja: 'ゲッタービジョン' }], ['shungensoku', { zh: '瞬幻足', en: 'Phantom Step', ja: '瞬幻足' }],
  ['hyper_jammer', { zh: '超级干扰器', en: 'Hyper Jammer', ja: 'ハイパージャマー' }], ['hp_regen_10', { zh: 'HP 回复 10%', en: 'HP Regen 10%', ja: 'HP回復 10%' }],
  ['hp_regen_20', { zh: 'HP 回复 20%', en: 'HP Regen 20%', ja: 'HP回復 20%' }],
].map(([key, name]) => ({ key, label: L(name as any) }));
const skills = [
  ['newtype', { zh: 'NT', en: 'Newtype', ja: 'NT' }], ['enhanced', { zh: '强化人', en: 'Enhanced', ja: '強化' }],
  ['holy_warrior', { zh: '圣战士', en: 'Holy Warrior', ja: '聖戦士' }], ['esp', { zh: '超能力', en: 'ESP', ja: '超能力' }],
  ['potential', { zh: '底力', en: 'Potential', ja: '底力' }], ['parry', { zh: '切落', en: 'Parry', ja: '切り払い' }],
  ['shield_defense', { zh: '盾防', en: 'Shield Defense', ja: 'S防御' }],
].map(([key, name]) => ({ key, label: L(name as any), row: ['parry', 'shield_defense'].includes(key as string) ? 1 : 0 }));
const spiritNames: Record<string, { zh: string; en: string; ja: string }> = {
  self_destruct: { zh: '自爆', en: 'Self-Destruct', ja: '自爆' }, scout: { zh: '侦察', en: 'Scan', ja: '偵察' }, accel: { zh: '加速', en: 'Accel', ja: '加速' },
  mercy: { zh: '手下留情', en: 'Mercy', ja: 'てかげん' }, focus: { zh: '集中', en: 'Focus', ja: '集中' }, alert: { zh: '必闪', en: 'Flash', ja: 'ひらめき' },
  guts: { zh: '毅力', en: 'Vigor', ja: '根性' }, strike: { zh: '必中', en: 'Bullseye', ja: '必中' }, trust: { zh: '信赖', en: 'Trust', ja: '信頼' },
  wall: { zh: '铁壁', en: 'Wall', ja: '鉄壁' }, cover: { zh: '替身', en: 'Cover', ja: 'みがわり' }, valor: { zh: '热血', en: 'Valor', ja: '熱血' },
  spirit: { zh: '气合', en: 'Spirit', ja: '気合' }, great_guts: { zh: '大毅力', en: 'Guts', ja: 'ド根性' }, luck: { zh: '幸运', en: 'Fortune', ja: '幸運' },
  drain: { zh: '脱力', en: 'Daunt', ja: '脱力' }, effort: { zh: '努力', en: 'Gain', ja: '努力' }, soul: { zh: '魂', en: 'Soul', ja: '魂' },
  stealth: { zh: '隐身', en: 'Stealth', ja: '隠れ身' }, awaken: { zh: '觉醒', en: 'Zeal', ja: '覚醒' }, refuel: { zh: '补给', en: 'Resupply', ja: '補給' },
  provoke: { zh: '挑衅', en: 'Taunt', ja: '挑発' }, encourage: { zh: '激励', en: 'Rouse', ja: '激励' }, disrupt: { zh: '扰乱', en: 'Disrupt', ja: 'かく乱' },
  friendship: { zh: '友情', en: 'Faith', ja: '友情' }, love: { zh: '爱', en: 'Love', ja: '愛' }, reactivate: { zh: '再动', en: 'Enable', ja: '再動' },
  miracle: { zh: '奇迹', en: 'Miracle', ja: '奇跡' }, prayer: { zh: '祈祷', en: 'Prayer', ja: '祈り' }, revive: { zh: '复活', en: 'Revive', ja: '復活' },
};
const spirits = Object.entries(spiritNames).map(([key, name]) => ({ key, label: L(name) }));
const labels = { fields, abilities, skills, spirits, sizes: ['SS', 'S', 'M', 'L', 'LL'] };
const pick = pickables(lang, data.units.map((u) => u.id), data.pilots.map((p) => p.id));
const notice = versionNotice(lang, text.game);
---
<Base lang={lang} title={title[tl(lang)]} description={lead[tl(lang)]}>
  <div class="wrap maker" data-maker>
    <header class="page-head">
      <span class="tag">MOD</span>
      <h1>{title[tl(lang)]}</h1>
      {notice && <p class="version-notice">{notice}</p>}
      <p>{lead[tl(lang)]}</p>
      <p class="note"><a href={`/${lang}/docs/mod-data/`}>{L({ zh: '数值 MOD 说明', en: 'Number mods guide', ja: '数値 MOD の説明' })}</a> · <a href={`/${lang}/mods/ids/units/`}>{L({ zh: 'ID 表', en: 'ID tables', ja: 'ID 表' })}</a> · {L({ zh: '需要 0.5.2 或更新的版本。所有处理都在浏览器里完成。', en: 'Needs 0.5.2 or later. Everything happens in your browser.', ja: '0.5.2 以降が必要です。処理はすべてブラウザー内で行われます。' })}</p>
    </header>

    <ModPackageForm lang={lang} placeholder="yourname.balance" />

    <section class="block">
      <div class="kinds" role="tablist">
        <button type="button" class="kind on" data-kind="units">{text.units}</button>
        <button type="button" class="kind" data-kind="pilots">{text.pilots}</button>
        <button type="button" class="kind" data-kind="weapons">{text.weapons}</button>
      </div>
      <div data-pick></div>
      <div data-weapon-list></div>
      <input type="search" class="find" data-find placeholder={text.findWeapon} autocomplete="off" spellcheck="false" hidden />
      <ul class="results" data-results></ul>
      <div data-editor></div>
    </section>

    <section class="block">
      <h2>{text.edited}</h2>
      <div data-edited></div>
    </section>

    <section class="block">
      <h2>{text.export}</h2>
      <button type="button" class="btn big" data-export>{text.exportButton}</button>
      <p class="status" data-export-status></p>
    </section>
  </div>
  <script type="application/json" id="maker-data" is:inline set:html={JSON.stringify({ text, labels, pick, locale: langInfo(lang).tag, lang: tl(lang) })}></script>
  <script>
    import { initDataMaker } from '../../../scripts/data-maker';
    initDataMaker();
  </script>
</Base>
