// weapons field by field against the original values and export data/*.json in a package,
// all in the browser (scripts/data-maker.ts). The values are export_data_tables.py's.
import Base from '../../../layouts/Base.astro';
import AiGuide from '../../../components/AiGuide.astro';
import ModPackageForm from '../../../components/ModPackageForm.astro';
import { langInfo, langPaths, tl, type Lang } from '../../../i18n';
import { packageText, versionNotice } from '../../../lib/mod-maker-text';
