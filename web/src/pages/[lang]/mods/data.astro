const spiritNames: Record<string, { zh: string; en: string; ja: string; ko: string }> = {
  self_destruct: { zh: '自爆', en: 'Self-Destruct', ja: '自爆', ko: '자폭' }, scout: { zh: '侦察', en: 'Scan', ja: '偵察', ko: '정찰' }, accel: { zh: '加速', en: 'Accel', ja: '加速', ko: '가속' },
  mercy: { zh: '手下留情', en: 'Mercy', ja: 'てかげん', ko: '힘조절' }, focus: { zh: '集中', en: 'Focus', ja: '集中', ko: '집중' }, alert: { zh: '必闪', en: 'Flash', ja: 'ひらめき', ko: '번뜩임' },
  guts: { zh: '毅力', en: 'Vigor', ja: '根性', ko: '근성' }, strike: { zh: '必中', en: 'Bullseye', ja: '必中', ko: '필중' }, trust: { zh: '信赖', en: 'Trust', ja: '信頼', ko: '신뢰' },
  wall: { zh: '铁壁', en: 'Wall', ja: '鉄壁', ko: '철벽' }, cover: { zh: '替身', en: 'Cover', ja: 'みがわり', ko: '대신 맞기' }, valor: { zh: '热血', en: 'Valor', ja: '熱血', ko: '열혈' },
  spirit: { zh: '气合', en: 'Spirit', ja: '気合', ko: '기합' }, great_guts: { zh: '大毅力', en: 'Guts', ja: 'ド根性', ko: '초근성' }, luck: { zh: '幸运', en: 'Fortune', ja: '幸運', ko: '행운' },
  drain: { zh: '脱力', en: 'Daunt', ja: '脱力', ko: '탈력' }, effort: { zh: '努力', en: 'Gain', ja: '努力', ko: '노력' }, soul: { zh: '魂', en: 'Soul', ja: '魂', ko: '혼' },
  stealth: { zh: '隐身', en: 'Stealth', ja: '隠れ身', ko: '은신' }, awaken: { zh: '觉醒', en: 'Zeal', ja: '覚醒', ko: '각성' }, refuel: { zh: '补给', en: 'Resupply', ja: '補給', ko: '보급' },
  provoke: { zh: '挑衅', en: 'Taunt', ja: '挑発', ko: '도발' }, encourage: { zh: '激励', en: 'Rouse', ja: '激励', ko: '격려' }, disrupt: { zh: '扰乱', en: 'Disrupt', ja: 'かく乱', ko: '교란' },
  friendship: { zh: '友情', en: 'Faith', ja: '友情', ko: '우정' }, love: { zh: '爱', en: 'Love', ja: '愛', ko: '사랑' }, reactivate: { zh: '再动', en: 'Enable', ja: '再動', ko: '재동' },
  miracle: { zh: '奇迹', en: 'Miracle', ja: '奇跡', ko: '기적' }, prayer: { zh: '祈祷', en: 'Prayer', ja: '祈り', ko: '기도' }, revive: { zh: '复活', en: 'Revive', ja: '復活', ko: '부활' },
};
const spirits = Object.entries(spiritNames).map(([key, name]) => ({ key, label: L(name) }));
const weaponChoices = {
  attack: [['melee', { zh: '格斗', en: 'Melee', ja: '格闘', ko: '격투' }], ['ranged', { zh: '射击', en: 'Ranged', ja: '射撃', ko: '사격' }]],
  terrain_at: [['attacker', { zh: '自己所在格', en: 'The attacker’s square', ja: '自分のマス', ko: '자신이 있는 칸' }], ['target', { zh: '目标所在格', en: 'The target’s square', ja: '相手のマス', ko: '목표가 있는 칸' }]],
  requires: [
    [null, { zh: '无', en: 'None', ja: 'なし', ko: '없음' }], ['ally', { zh: '只有我方能用', en: 'Our side only', ja: '味方のみ', ko: '아군만 사용 가능' }],
    ['hyper_mode', { zh: '明镜止水', en: 'Hyper Mode', ja: '明鏡止水', ko: '명경지수' }], ['super_mode', { zh: '超级模式', en: 'Super Mode', ja: 'スーパーモード', ko: '슈퍼 모드' }],
    ['level_10', 'LV10'], ['level_15', 'LV15'], ['level_20', 'LV20'], ['level_25', 'LV25'], ['level_30', 'LV30'], ['level_35', 'LV35'], ['level_45', 'LV45'],
    ['newtype', { zh: 'NT／强化人 L1', en: 'Newtype / Enhanced L1', ja: 'NT／強化 L1', ko: '뉴타입 / 강화인간 L1' }], ['newtype_4', { zh: 'NT／强化人 L4', en: 'Newtype / Enhanced L4', ja: 'NT／強化 L4', ko: '뉴타입 / 강화인간 L4' }],
    ['holy_warrior', { zh: '圣战士 L1', en: 'Holy Warrior L1', ja: '聖戦士 L1', ko: '성전사 L1' }], ['holy_warrior_3', { zh: '圣战士 L3', en: 'Holy Warrior L3', ja: '聖戦士 L3', ko: '성전사 L3' }],
    ['v_max', 'V-MAX'], ['v_max_red', { zh: 'V-MAX 红色力量', en: 'V-MAX red power', ja: 'V-MAX レッドパワー', ko: 'V-MAX 레드 파워' }],
  ],
} as Record<string, [string | null, string | { zh: string; en: string; ja: string; ko: string }][]>;
const choices = Object.fromEntries(Object.entries(weaponChoices).map(([k, list]) => [k, list.map(([value, name]) => ({ value, label: typeof name === 'string' ? name : L(name) }))]));
const labels = { fields, abilities, skills, spirits, sizes: ['SS', 'S', 'M', 'L', 'LL'], choices };
const pick = pickables(lang, data.units.map((u) => u.id), data.pilots.map((p) => p.id));
const notice = versionNotice(lang, text.game);
---
<Base lang={lang} title={title[tl(lang)]} description={lead[tl(lang)]}>
  <div class="wrap maker" data-maker>
    <header class="page-head">
      <span class="tag">MOD</span>
      <h1>{title[tl(lang)]}</h1>
      {notice && <p class="version-notice">{notice}</p>}
      <p>{lead[tl(lang)]}</p>
      <p class="note"><a href={`/${lang}/docs/mod-data/`}>{L({ zh: '数值 MOD 说明', en: 'Number mods guide', ja: '数値 MOD の説明', ko: '수치 MOD 설명' })}</a> · <a href={`/${lang}/mods/ids/units/`}>{L({ zh: 'ID 表', en: 'ID tables', ja: 'ID 表', ko: 'ID 표' })}</a> · {L({ zh: '需要 0.5.2 或更新的版本。所有处理都在浏览器里完成。', en: 'Needs 0.5.2 or later. Everything happens in your browser.', ja: '0.5.2 以降が必要です。処理はすべてブラウザー内で行われます。', ko: '0.5.2 이상 버전이 필요합니다. 모든 처리는 브라우저 안에서 이루어집니다.' })}</p>
    </header>
    <AiGuide lang={lang} kind="data" />

    <ModPackageForm lang={lang} placeholder="yourname.balance" />

    <section class="block">
      <div class="kinds" role="tablist">
        <button type="button" class="kind on" data-kind="units">{text.units}</button>
        <button type="button" class="kind" data-kind="pilots">{text.pilots}</button>
        <button type="button" class="kind" data-kind="weapons">{text.weapons}</button>
      </div>
      <div data-pick></div>
      <div data-weapon-list></div>
      <input type="search" class="find" data-find placeholder={text.findWeapon} autocomplete="off" spellcheck="false" hidden />
      <ul class="results" data-results></ul>
      <div data-editor></div>
    </section>

    <section class="block">
      <h2>{text.edited}</h2>
      <div data-edited></div>
    </section>

    <section class="block">
      <h2>{text.export}</h2>
      <button type="button" class="btn big" data-export>{text.exportButton}</button>
      <p class="status" data-export-status></p>
    </section>
  </div>
  <script type="application/json" id="maker-data" is:inline set:html={JSON.stringify({ text, labels, pick, locale: langInfo(lang).tag, lang: tl(lang) })}></script>
  <script>
    import { initDataMaker } from '../../../scripts/data-maker';
    initDataMaker();
  </script>
</Base>
