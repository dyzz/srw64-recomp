import data from '../../../data/data-mods.json';
import '../../../styles/mod-maker.css';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const L = <T,>(v: { zh: T; en: T; ja: T; ko: T }) => v[tl(lang)];
