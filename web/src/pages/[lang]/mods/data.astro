---
// The number MOD maker (docs/design/mod-names-art-data.md §2.3): change units, pilots and
// weapons field by field against the original values and export data/*.json in a package,
// all in the browser (scripts/data-maker.ts). The values are export_data_tables.py's.
import Base from '../../../layouts/Base.astro';
import SubmitHint from '../../../components/SubmitHint.astro';
import AiGuide from '../../../components/AiGuide.astro';
import ModPackageForm from '../../../components/ModPackageForm.astro';
import { langInfo, langPaths, tl, type Lang } from '../../../i18n';
import { packageText, versionNotice } from '../../../lib/mod-maker-text';
import { pickables } from '../../../lib/mod-picker';
import { dataFields } from '../../../lib/data-fields';
import data from '../../../data/data-mods.json';
import '../../../styles/mod-maker.css';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const L = <T,>(v: { zh: T; en: T; ja: T; ko: T }) => v[tl(lang)];
const title = { zh: '数值 MOD 制作', en: 'Number mod maker', ja: '数値 MOD メーカー', ko: '수치 MOD 제작' };
const lead = {
  zh: '挑机体、人物或武器，改 HP、装甲、能力值、地形适应、特殊能力、技能、精神、武器威力和射程，导出 .srw64mod 拖进游戏窗口即可安装。每一项旁边都有原版的值，只有改过的会写进包里。',
  en: 'Pick units, pilots or weapons and change HP, armor, stats, terrain ranks, abilities, skills, spirits, weapon power and range; drag the exported .srw64mod into the game window to install it. Each field shows the original value, and only what you change goes into the package.',
  ja: 'ユニット・キャラクター・武器を選んで、HP・装甲・能力値・地形適応・特殊能力・技能・精神・武器の攻撃力や射程を変え、書き出した .srw64mod をゲームのウィンドウにドラッグしてインストールします。各項目に原作の値が出ており、変えた項目だけがパッケージに入ります。',
  ko: '기체, 파일럿, 무기를 골라 HP, 장갑, 능력치, 지형 적응, 특수 능력, 특수 기능, 정신기, 무기 공격력과 사거리를 바꾸고, 내보낸 .srw64mod를 게임 창에 끌어다 놓으면 설치됩니다. 각 항목 옆에 원본 값이 표시되며, 바꾼 항목만 패키지에 들어갑니다.',
};
const fields = dataFields(lang);
const text = {
  ...packageText(lang),
  units: L({ zh: '机体', en: 'Units', ja: 'ユニット', ko: '기체' }),
  pilots: L({ zh: '人物', en: 'Pilots', ja: 'キャラクター', ko: '파일럿' }),
  weapons: L({ zh: '武器', en: 'Weapons', ja: '武器', ko: '무기' }),
  allSeries: L({ zh: '全部作品', en: 'All series', ja: 'すべての作品', ko: '모든 작품' }),
  pickUnitFirst: L({ zh: '先选机体，再选它的武器。', en: 'Pick a unit, then one of its weapons.', ja: 'ユニットを選んでから、その武器を選んでください。', ko: '기체를 고른 다음 그 기체의 무기를 고르세요.' }),
  weaponsOf: L({ zh: '{unit} 的武器', en: 'Weapons of {unit}', ja: '{unit} の武器', ko: '{unit}의 무기' }),
  findWeapon: L({ zh: '或直接按武器名、编号查找', en: 'Or find a weapon by name or number', ja: 'または武器名・番号で検索', ko: '또는 무기 이름이나 번호로 바로 검색' }),
  unitWeapons: L({ zh: '这台机体的武器', en: 'This unit’s weapons', ja: 'このユニットの武器', ko: '이 기체의 무기' }),
  edited: L({ zh: '已改动', en: 'Changed', ja: '変更済み', ko: '변경됨' }),
  editedNone: L({ zh: '还没有改动。在上面查找并选中一项开始改。', en: 'Nothing changed yet. Search above and pick an entry.', ja: 'まだ変更はありません。上で検索して項目を選んでください。', ko: '아직 변경한 항목이 없습니다. 위에서 검색해 항목을 고르세요.' }),
  errEmpty: L({ zh: '还没有改动任何数值', en: 'Nothing is changed yet', ja: 'まだ何も変えていません', ko: '아직 바꾼 수치가 없습니다' }),
  shared: L({ zh: '共用这条能力记录，会一起变：', en: 'Share this record and change with it: ', ja: 'この記録を共有し、一緒に変わります：', ko: '이 능력 기록을 함께 쓰므로 같이 바뀝니다: ' }),
  carriers: L({ zh: '带这件武器的机体，会一起变：', en: 'Units carrying it, which all change: ', ja: 'この武器を持つユニット（全員分変わります）：', ko: '이 무기를 가진 기체 (모두 같이 바뀝니다): ' }),
  noRecord: L({ zh: '这个人物没有能力记录，不能改数值', en: 'This pilot has no ability record to change', ja: 'このキャラクターには能力記録がありません', ko: '이 파일럿에게는 바꿀 수 있는 능력 기록이 없습니다' }),
  ...fields.text,
  game: '0.5.2',
};
const labels = fields.labels;
const pick = pickables(lang, data.units.map((u) => u.id), data.pilots.map((p) => p.id));
const notice = versionNotice(lang, text.game);
---
<Base lang={lang} title={title[tl(lang)]} description={lead[tl(lang)]}>
  <div class="wrap maker" data-maker>
    <header class="page-head">
      <span class="tag">MOD</span>
      <h1>{title[tl(lang)]}</h1>
      {notice && <p class="version-notice">{notice}</p>}
      <p>{lead[tl(lang)]}</p>
      <p class="note"><a href={`/${lang}/docs/mod-data/`}>{L({ zh: '数值 MOD 说明', en: 'Number mods guide', ja: '数値 MOD の説明', ko: '수치 MOD 설명' })}</a> · <a href={`/${lang}/mods/ids/units/`}>{L({ zh: 'ID 表', en: 'ID tables', ja: 'ID 表', ko: 'ID 표' })}</a> · {L({ zh: '需要 0.5.2 或更新的版本。所有处理都在浏览器里完成。', en: 'Needs 0.5.2 or later. Everything happens in your browser.', ja: '0.5.2 以降が必要です。処理はすべてブラウザー内で行われます。', ko: '0.5.2 이상 버전이 필요합니다. 모든 처리는 브라우저 안에서 이루어집니다.' })}</p>
    </header>
    <AiGuide lang={lang} kind="data" />

    <ModPackageForm lang={lang} placeholder="yourname.balance" />

    <section class="block">
      <div class="kinds" role="tablist">
        <button type="button" class="kind on" data-kind="units">{text.units}</button>
        <button type="button" class="kind" data-kind="pilots">{text.pilots}</button>
        <button type="button" class="kind" data-kind="weapons">{text.weapons}</button>
      </div>
      <div data-pick></div>
      <div data-weapon-list></div>
      <input type="search" class="find" data-find placeholder={text.findWeapon} autocomplete="off" spellcheck="false" hidden />
      <ul class="results" data-results></ul>
      <div data-editor></div>
    </section>

    <section class="block">
      <h2>{text.edited}</h2>
      <div data-edited></div>
    </section>

    <section class="block">
      <h2>{text.export}</h2>
      <button type="button" class="btn big" data-export>{text.exportButton}</button>
      <p class="status" data-export-status></p>
      <SubmitHint lang={lang} />
    </section>
  </div>
  <script type="application/json" id="maker-data" is:inline set:html={JSON.stringify({ text, labels, pick, locale: langInfo(lang).tag, lang: tl(lang) })}></script>
  <script>
    import { initDataMaker } from '../../../scripts/data-maker';
    initDataMaker();
  </script>
</Base>
