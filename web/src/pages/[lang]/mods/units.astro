  p_anim_behavior: L({ zh: '行为号要在 3–382', en: 'behaviours are 3 to 382', ja: '行動番号は 3〜382 です', ko: '행동 번호는 3~382여야 합니다' }),
  p_anim_long: L({ zh: '演出记录太长（演员太多）', en: 'the animation record is too long (too many actors)', ja: '演出レコードが長すぎます（アクターが多すぎ）', ko: '연출 레코드가 너무 깁니다(액터가 너무 많음)' }),
