  animSize: L({ zh: '{actors} 个演员，记录 {bytes} 字节（上限 {most}）', en: '{actors} actors, {bytes} bytes (up to {most})', ja: 'アクター {actors} 個、{bytes} バイト（上限 {most}）', ko: '액터 {actors}개, {bytes}바이트(최대 {most})' }),
