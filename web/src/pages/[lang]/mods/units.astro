  reframe: L({ zh: '重新框选', en: 'Frame again', ja: '枠をやり直す', ko: '다시 맞추기' }),
  errPicture: L({ zh: '读不了这张图：{detail}', en: 'Could not read the picture: {detail}', ja: '画像を読み込めません：{detail}', ko: '그림을 읽을 수 없습니다: {detail}' }),
  p_iconFraming: L({ zh: '地图图标还没点「确定」', en: 'the map icon is not confirmed yet', ja: 'マップアイコンがまだ「決定」されていません', ko: '맵 아이콘을 아직 “확인”하지 않았습니다' }),
  p_spriteNoArt: L({ zh: '图片文件不在包里，重新选图或删掉', en: 'its files are not in the package; pick the pictures again or delete it', ja: '画像ファイルがパッケージにありません。選び直すか削除してください', ko: '그림 파일이 패키지에 없습니다. 다시 고르거나 지우세요' }),
  p_sprite_frames: L({ zh: '要有 1–64 帧', en: 'needs 1 to 64 frames', ja: 'コマは 1〜64 です', ko: '프레임은 1~64개여야 합니다' }),
  p_sprite_hd: L({ zh: 'HD 图要每帧一张', en: 'needs an HD picture for each frame', ja: 'HD 画像はコマごとに 1 枚です', ko: 'HD 그림은 프레임마다 한 장이어야 합니다' }),
  p_sprite_origin: L({ zh: '原点要是 −2048 到 2048 的整数', en: 'the origin is whole numbers from −2048 to 2048', ja: '原点は −2048〜2048 の整数です', ko: '원점은 −2048~2048의 정수여야 합니다' }),
  p_sprite_ticks: L({ zh: '每帧拍数要是 1–255', en: 'each frame’s ticks are 1 to 255', ja: 'コマごとの拍数は 1〜255 です', ko: '프레임별 박자 수는 1~255여야 합니다' }),
  p_sprite_loop: L({ zh: '循环帧超出了帧数', en: 'the loop frame is past the last frame', ja: 'ループのコマがコマ数を超えています', ko: '반복 프레임이 프레임 수를 넘습니다' }),
  p_pose_missing: L({ zh: '站姿 {sprite} 不在战斗图里', en: 'the pose {sprite} is not among the battle pictures', ja: '立ち絵 {sprite} が戦闘グラフィックにありません', ko: '대기 자세 {sprite}이(가) 전투 그림에 없습니다' }),
  p_scene_missing: L({ zh: '场景用的 {sprite} 不在战斗图里', en: 'the scene’s {sprite} is not among the battle pictures', ja: 'シーンの {sprite} が戦闘グラフィックにありません', ko: '장면의 {sprite}이(가) 전투 그림에 없습니다' }),
  p_framing: L({ zh: '头像还没点「确定」', en: 'the portrait is not confirmed yet', ja: '顔グラフィックがまだ「決定」されていません', ko: '초상화를 아직 “확인”하지 않았습니다' }),
};
const pick = pickables(lang, data.units.map((u) => u.id), data.pilots.map((p) => p.id));
const works = pick.series.filter((s) => s.id !== null && s.id <= 24).map((s) => ({ id: s.id as number, name: s.name }));
const notice = versionNotice(lang, '0.5.4');
---
<Base lang={lang} title={title[tl(lang)]} description={lead[tl(lang)]}>
  <div class="wrap maker" data-unit-maker>
    <header class="page-head">
      <span class="tag">MOD</span>
      <h1>{title[tl(lang)]}</h1>
      {notice && <p class="version-notice">{notice}</p>}
      <p>{lead[tl(lang)]}</p>
      <p class="note"><a href={`/${lang}/mods/ids/units/`}>{L({ zh: 'ID 表', en: 'ID tables', ja: 'ID 表', ko: 'ID 표' })}</a> · {L({ zh: '所有处理都在浏览器里完成；没导出的进度存在这个浏览器里（图片除外）。', en: 'Everything happens in your browser; work not exported yet is kept in this browser (pictures aside).', ja: '処理はすべてブラウザー内で行われます。書き出していない作業はこのブラウザーに保存されます（画像を除く）。', ko: '모든 처리는 브라우저 안에서 이루어집니다. 내보내지 않은 작업은 이 브라우저에 저장됩니다 (그림 제외).' })}</p>
    </header>

    <ModPackageForm lang={lang} placeholder="yourname.units" />

    <section class="block">
      <div class="kinds" role="tablist">
        <button type="button" class="kind on" data-kind="pilots">{text.newPilots} <span class="count">0</span></button>
        <button type="button" class="kind" data-kind="units">{text.newUnits} <span class="count">0</span></button>
        <button type="button" class="kind" data-kind="weapons">{text.newWeapons} <span class="count">0</span></button>
        <button type="button" class="kind" data-kind="sprites">{text.sprites} <span class="count">0</span></button>
      </div>
      <div data-list></div>
      <div data-add></div>
      <div data-editor></div>
    </section>

    <section class="block">
      <h2>{text.problems}</h2>
      <div data-problems></div>
      <p class="status" data-status></p>
    </section>

    <section class="block">
      <h2>{text.export}</h2>
      <button type="button" class="btn big" data-export>{text.exportButton}</button>
      <p class="status" data-export-status></p>
      <SubmitHint lang={lang} />
    </section>
  </div>
  <script type="application/json" id="unit-maker-data" is:inline set:html={JSON.stringify({ text, labels: fields.labels, pick, works, locale: langInfo(lang).tag, lang: tl(lang) })}></script>
  <script>
    import { initUnitMaker } from '../../../scripts/unit-maker';
    initUnitMaker();
  </script>
</Base>
