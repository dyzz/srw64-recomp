---
// One stage, laid out like the SRW Z review site's stage page: a header band with the
// stage's numbers, a search bar for this stage, a table of contents listing every node
// (opening, each map event with its trigger, ending), and the lines as cards.
import Base from '../../../layouts/Base.astro';
import { LANGS, UI, canReview, type Lang } from '../../../i18n';
import { library, scene as loadScene, storyIndex, type Line } from '../../../lib/data';

export async function getStaticPaths() {
  return LANGS.flatMap((l) => storyIndex().map((s) => ({ params: { lang: l.code, scene: String(s.scene) } })));
}
const lang = Astro.params.lang as Lang;
const review = canReview(lang);
const s = loadScene(Number(Astro.params.scene));
const all = storyIndex();
const titleOf = (n: number) => all.find((x) => x.scene === n)?.title[lang] ?? `#${n}`;
const t = {
  stage: { zh: (n: string) => `第 ${n} 话`, en: (n: string) => `Stage ${n}`, ja: (n: string) => `第${n}話` },
  back: { zh: '全部关卡', en: 'All stages', ja: '全ステージ' },
  prev: { zh: '上一话', en: 'Previous', ja: '前の話' },
  next: { zh: '下一话', en: 'Next', ja: '次の話' },
  lines: { zh: '句台词', en: 'lines', ja: '行のセリフ' },
  nodes: { zh: '个节点', en: 'nodes', ja: 'ノード' },
  choices: { zh: '个选择肢', en: 'choices', ja: '選択肢' },
  suggestions: { zh: '条意见', en: 'suggestions', ja: '件の意見' },
  count: { zh: (n: number) => `${n} 句`, en: (n: number) => `${n} lines`, ja: (n: number) => `${n} 行` },
  toc: { zh: '本关目录', en: 'In this stage', ja: 'このステージ' },
  jump: { zh: '跳转到节点…', en: 'Jump to a node…', ja: 'ノードへ移動…' },
  search: { zh: '搜索本关', en: 'Search this stage', ja: 'このステージを検索' },
  searchPh: { zh: '输入日文、译文或人物名', en: 'Enter original text, a translation or a character name', ja: '原文・訳文・キャラクター名を入力' },
  prevHit: { zh: '上一处', en: 'Prev', ja: '前へ' },
  nextHit: { zh: '下一处', en: 'Next', ja: '次へ' },
  onlyReviewed: { zh: '只看有意见的台词', en: 'Only lines with suggestions', ja: '意見のある行のみ' },
  translation: { zh: '译文', en: 'Translation', ja: '翻訳' },
  original: { zh: '日文', en: 'Japanese', ja: '原文' },
  show: { zh: '显示', en: 'Show', ja: '表示' },
  hide: { zh: '隐藏', en: 'Hide', ja: '非表示' },
  none: { zh: '不显示', en: 'None', ja: 'なし' },
  jaLabel: { zh: '日文', en: 'JA', ja: '原文' },
  suggest: { zh: '提建议', en: 'Suggest', ja: '意見' },
  choice: { zh: '选择肢', en: 'Choice', ja: '選択肢' },
  node: { zh: (n: number) => `节点 ${n}`, en: (n: number) => `Node ${n}`, ja: (n: number) => `ノード ${n}` },
  heroDep: { zh: '随所选主角变化', en: 'Varies by protagonist', ja: '主人公によって変化' },
  note: {
    zh: '头像取自 HD 美术包。台词编号与游戏的台词文件一致，每句都可直接链接。原版脚本将各主角的路线写在同一关内，这里按段落标注路线。能确定主角的关卡或段落会显示对应主角和搭档；其余位置使用〈主角〉〈搭档〉，超级系和真实系关卡另会标出两位候选主角。',
    en: 'Portraits use the HD art pack. Line numbers match the game’s dialogue files, and each line has a direct link. The original script combines the protagonists’ routes within each stage, so passages are labelled by route. Where the stage or passage identifies the protagonist, that protagonist and partner are shown. Elsewhere, ⟨Hero⟩ and ⟨Partner⟩ are used; Super and Real stages also list the two possible protagonists.',
    ja: '顔グラフィックは HD アートパックのものです。行番号はゲームのセリフファイルと一致し、各行に直接リンクできます。原作のスクリプトでは各主人公のルートが同じステージに含まれるため、段落ごとにルートを示しています。主人公が特定できるステージや段落では、その主人公とパートナーを表示します。それ以外は〈主人公〉〈パートナー〉とし、スーパー系・リアル系のステージでは候補の 2 人も示します。',
  },
};
const SECTIONS = {
  opening: { kicker: 'OPENING', title: { zh: '开场', en: 'Opening', ja: 'オープニング' }, desc: { zh: '关卡开始时的剧情。', en: 'Story at the start of the stage.', ja: 'ステージ開始時のシナリオ。' } },
  map: { kicker: 'ON THE MAP', title: { zh: '战场', en: 'On the map', ja: 'マップ' }, desc: { zh: '战斗中满足条件时触发的事件，按脚本顺序排列，并标明各节点的触发条件。', en: 'Events triggered during battle, listed in script order. Each node shows its trigger conditions.', ja: '戦闘中に条件を満たすと発生するイベントを、スクリプト順に表示します。各ノードに発生条件を示しています。' } },
  ending: { kicker: 'ENDING', title: { zh: '过关后', en: 'After the stage', ja: 'クリア後' }, desc: { zh: '过关后的剧情。', en: 'The story after the stage is cleared.', ja: 'ステージクリア後のシナリオ。' } },
} as const;
// What kind of condition a map event has, from its Chinese trigger text.
const CATS = {
  turn: { zh: '回合', en: 'Turn', ja: 'ターン' },
  defeat: { zh: '击破', en: 'Defeat', ja: '撃破' },
  wipe: { zh: '全灭', en: 'Wiped out', ja: '全滅' },
  count: { zh: '剩余', en: 'Remaining', ja: '残り' },
  hp: { zh: 'HP', en: 'HP', ja: 'HP' },
  delay: { zh: '延时', en: 'Delayed', ja: '遅延' },
  place: { zh: '到达', en: 'Reach', ja: '到達' },
  other: { zh: '条件', en: 'Condition', ja: '条件' },
} as const;
function category(zh = ''): keyof typeof CATS {
  if (/剩余 0 台/.test(zh)) return 'wipe';
  if (/回合/.test(zh)) return 'turn';
  if (/击破|撤退/.test(zh)) return 'defeat';
  if (/剩余/.test(zh)) return 'count';
  if (/HP/.test(zh)) return 'hp';
  if (/延时/.test(zh)) return 'delay';
  if (/到达|进入|抵达/.test(zh)) return 'place';
  return 'other';
}
const PH: Record<string, Record<Lang, string>> = {
  Hero: { zh: '〈主角〉', en: '⟨Hero⟩', ja: '〈主人公〉' },
  Partner: { zh: '〈搭档〉', en: '⟨Partner⟩', ja: '〈パートナー〉' },
  HeroMech: { zh: '〈主角机〉', en: '⟨Hero’s mech⟩', ja: '〈主人公機〉' },
};
// Who the hero is, where the script settles it: a stage on one hero's lane (stages 1–6,
// the Ark and Brad side stories), or a passage behind one hero's route marker. The
// Super stages narrow it to Brad or Manami, the Real ones to Ark or Selain.
const HEROES = ['ark', 'selain', 'brad', 'manami'] as const;
type Hero = (typeof HEROES)[number];
const HERO_IDS: Record<Hero, [number, number]> = { ark: [25, 29], selain: [26, 30], brad: [27, 31], manami: [28, 32] };
const people = new Map(library().people.map((p) => [p.id, p]));
const heroName = (h: Hero, l: Lang) => people.get(HERO_IDS[h][0])!.name[l];
const laneHeroes = new Set(HEROES.filter((h) => s.episode?.lanes.length && s.episode.lanes.every((x) => x.zh.includes(heroName(h, 'zh')))));
const stageHeroes: Hero[] = laneHeroes.size ? [...laneHeroes]
  : s.episode?.routes.length === 1 && s.episode.routes[0] === 'super' ? ['brad', 'manami']
  : s.episode?.routes.length === 1 && s.episode.routes[0] === 'real' ? ['ark', 'selain'] : [...HEROES];
// Names that fill {HeroName}-style placeholders once the hero is known.
function fill(ph: string, h: Hero, l: Lang) {
  const [hero, partner] = HERO_IDS[h].map((id) => people.get(id)!);
  if (ph === 'HeroMech') return null;
  const p = ph.startsWith('Partner') ? partner : ph.startsWith('Hero') ? hero : null;
  if (!p) return null;
  if (ph.endsWith('Full')) return p.full_name[l];
  if (ph.endsWith('Surname')) return l === 'ja' ? p.full_name.ja.split('・').pop()! : l === 'zh' ? p.full_name.zh.split('·').pop()! : p.full_name.en.split(' ').pop()!;
  return p.name[l];
}
const esc = (x: string) => x.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
// {HeroName}-style placeholders as marked spans (the suggestion form turns them back),
// showing the hero's names when the line's hero is settled.
function rich(text: string, l: Lang, hero: Hero | null = null) {
  return esc(text).replace(/\{([A-Za-z]+)\}/g, (_, ph: string) => {
    const label = (hero && fill(ph, hero, l)) || (ph === 'HeroMech' ? PH.HeroMech[l] : ph.startsWith('Partner') ? PH.Partner[l] : ph.startsWith('Hero') ? PH.Hero[l] : `{${ph}}`);
    return `<span class="ph" data-ph="${ph}">${esc(label)}</span>`;
  });
}
// Lines with the route passage they sit in; a marker shows only where the route changes.
type Shown = { line: Line; route: string | null; markerChange: boolean; heroes: Hero[] };
let nodeNo = 0;
const events = s.events.map((e) => {
  let lastMarker = '';
  let route: string | null = null;
  let heroes: Hero[] = stageHeroes;
  const shown: Shown[] = [];
  for (const line of e.lines) {
    if (line.t === 'route') {
      const change = line.marker !== lastMarker && !(line.marker === '3DD0' && lastMarker === '');
      lastMarker = line.marker;
      route = line.routes ? line.label[lang] : null;
      const marked = HEROES.filter((h) => line.routes?.includes(h));
      heroes = marked.length ? stageHeroes.filter((h) => marked.includes(h)) : stageHeroes;
      if (!heroes.length) heroes = marked;
      if (change) shown.push({ line, route, markerChange: true, heroes });
      continue;
    }
    const own = line.t === 'say' && HEROES.includes(line.route as Hero) ? [line.route as Hero] : heroes;
    shown.push({ line, route, markerChange: false, heroes: own });
  }
  const count = e.lines.filter((l) => l.t !== 'route').length;
  return { e, shown, count, no: ++nodeNo, cat: e.phase === 'map' ? category(e.trigger?.zh) : null };
});
const sections = (['opening', 'map', 'ending'] as const)
  .map((phase) => ({ phase, ...SECTIONS[phase], events: events.filter((x) => x.e.phase === phase) }))
  .filter((x) => x.events.length > 0)
  .map((x, i) => ({ ...x, no: String(i + 1).padStart(2, '0'), count: x.events.reduce((n, e) => n + e.count, 0) }));
const choiceCount = s.events.reduce((n, e) => n + e.lines.filter((l) => l.t === 'choice').length, 0);
const trLangs = (lang === 'ja' ? ['en', 'zh'] : [lang, lang === 'zh' ? 'en' : 'zh']) as Lang[];
const face = (id: number | null | undefined) => (id == null ? null : `/gen/portraits/${id}.webp`);
const pageTitle = `${s.episode ? t.stage[lang](s.episode.stage) + ' · ' : ''}${s.title[lang]}`;
const nodeTitle = (x: (typeof events)[number]) => x.e.trigger?.[lang] ?? x.e.label[lang];
---
<Base lang={lang} title={pageTitle} description={`${s.title.ja} · ${s.count}`} review={review}>
  <div data-story data-lang={lang} data-scene={s.scene}>
    <section class="hero">
      <div class="wrap">
        <a class="back" href={`/${lang}/story/`}>← {t.back[lang]}</a>
        <p class="kicker latin">{s.episode ? `STAGE ${s.episode.stage}` : `SCENE ${s.scene}`}</p>
        <h1>{s.episode && <span class="stno">{t.stage[lang](s.episode.stage)} · </span>}{s.title[lang]}</h1>
        {lang !== 'ja' && <p class="jt" lang="ja">{s.title.ja}</p>}
        <p class="sub">
          {s.episode?.lanes.map((l) => <span class="lane">{l[lang]}</span>)}
          {s.previous.length > 0 && <span class="pn">{t.prev[lang]} {s.previous.map((n) => <a href={`/${lang}/story/${n}/`}>{titleOf(n)}</a>)}</span>}
          {s.next.length > 0 && <span class="pn">{t.next[lang]} {s.next.map((n) => <a href={`/${lang}/story/${n}/`}>{titleOf(n)}</a>)}</span>}
        </p>
      </div>
      <div class="stats">
        <div class="wrap stats-in">
          <div><b class="latin">{s.count}</b><span>{t.lines[lang]}</span></div>
          <div><b class="latin">{events.length}</b><span>{t.nodes[lang]}</span></div>
          <div><b class="latin">{choiceCount}</b><span>{t.choices[lang]}</span></div>
          {review && <div><b class="latin" data-stat-suggestions>–</b><span>{t.suggestions[lang]}</span></div>}
        </div>
      </div>
    </section>

    <div class="bar">
      <div class="wrap bar-in">
        <label class="find">
          <span class="find-lbl">{t.search[lang]}</span>
          <input type="search" data-find placeholder={t.searchPh[lang]} aria-label={t.search[lang]} autocomplete="off" />
        </label>
        <span class="hits latin" data-hits></span>
        <button type="button" class="mini" data-hit="-1">{t.prevHit[lang]}</button>
        <button type="button" class="mini" data-hit="1">{t.nextHit[lang]}</button>
        {review && <button type="button" class="mini" data-only aria-pressed="false">{t.onlyReviewed[lang]} <span data-only-count></span></button>}
        <span class="sep"></span>
        <span class="lbl">{t.translation[lang]}</span>
        <div class="seg" data-control="tr">
          {trLangs.map((l, i) => <button type="button" data-value={l} aria-pressed={i === 0 ? 'true' : 'false'}>{LANGS.find((x) => x.code === l)!.label}</button>)}
          {lang === 'ja' && <button type="button" data-value="none" aria-pressed="false">{t.none[lang]}</button>}
        </div>
        {lang !== 'ja' && <>
          <span class="lbl">{t.original[lang]}</span>
          <div class="seg" data-control="ja">
            <button type="button" data-value="show" aria-pressed="true">{t.show[lang]}</button>
            <button type="button" data-value="hide" aria-pressed="false">{t.hide[lang]}</button>
          </div>
        </>}
      </div>
    </div>

    <div class="wrap body-grid">
      <aside class="toc">
        <p class="toc-title">{t.toc[lang]}</p>
        <ol>
          {sections.map((sec) => (
            <li class="toc-sec">
              <a href={`#sec-${sec.phase}`} data-toc={`sec-${sec.phase}`}><span class="no latin">{sec.no}</span><strong>{sec.title[lang]}</strong><span class="n latin">{sec.count}</span></a>
              {sec.phase === 'map' && <ol>
                {sec.events.map((x) => <li><a href={`#node-${x.no}`} data-toc={`node-${x.no}`}><span class={`cat c-${x.cat}`}>{CATS[x.cat!][lang]}</span><span class="tt">{nodeTitle(x)}</span></a></li>)}
              </ol>}
            </li>
          ))}
        </ol>
        <select class="toc-select" data-jump aria-label={t.jump[lang]}>
          <option value="">{t.jump[lang]}</option>
          {sections.map((sec) => <>
            <option value={`sec-${sec.phase}`}>{sec.no} {sec.title[lang]}</option>
            {sec.phase === 'map' && sec.events.map((x) => <option value={`node-${x.no}`}>　{CATS[x.cat!][lang]} · {nodeTitle(x)}</option>)}
          </>)}
        </select>
      </aside>

      <main class="main">
        {sections.map((sec) => (
          <section class="sec" id={`sec-${sec.phase}`}>
            <header class="sec-head">
              <span class="sec-no latin">{sec.no}</span>
              <div>
                <p class="sec-kicker latin">{sec.kicker}</p>
                <h2>{sec.title[lang]}</h2>
                <p class="sec-desc">{sec.desc[lang]}</p>
              </div>
              <span class="sec-count">{t.count[lang](sec.count)}</span>
            </header>
            {sec.events.map((x) => (
              <div class="node" id={`node-${x.no}`}>
                {(sec.phase === 'map' || sec.events.length > 1) && (
                  <div class="node-head">
                    <span class="node-no">{t.node[lang](x.no)}</span>
                    {x.cat && <span class={`cat c-${x.cat}`}>{CATS[x.cat][lang]}</span>}
                    <h3>{nodeTitle(x)}</h3>
                    <span class="node-count">{t.count[lang](x.count)}</span>
                  </div>
                )}
                {x.shown.map(({ line, route, markerChange, heroes }) => {
                  const hero = heroes.length === 1 ? heroes[0] : null;
                  if (line.t === 'route') return markerChange ? <div class="route-mark"><span>{line.label[lang]}</span></div> : null;
                  const anchor = `l${line.id}`;
                  if (line.t === 'choice') {
                    return (
                      <article class="line choice" id={anchor} data-id={line.id}>
                        <div class="face-col"><div class="face none" aria-hidden="true">?</div><a class="lid latin" href={`#${anchor}`}>@{line.id}</a></div>
                        <div class="body">
                          <div class="who"><strong class="name">{t.choice[lang]}</strong>{route && <span class="route">{route}</span>}{review && <button type="button" class="act" data-suggest={line.id}>{t.suggest[lang]}</button>}</div>
                          {trLangs.map((l) => <ol class={`tr tr-${l}`} lang={l === 'zh' ? 'zh-Hans' : l}>{(line[l][0] ?? '').split('\n').map((o) => <li set:html={rich(o, l, hero)} />)}</ol>)}
                          <div class="ja" lang="ja"><span class="ja-lbl">{t.jaLabel[lang]}</span><ol>{(line.ja[0] ?? '').split('\n').map((o) => <li set:html={rich(o, 'ja', hero)} />)}</ol></div>
                        </div>
                      </article>
                    );
                  }
                  // A hero-dependent speaker: the settled hero, else a plain face naming the candidates.
                  const pick = line.cands?.length && hero ? line.cands.find((c) => c.route === hero) : null;
                  const open = line.cands?.length && !pick;
                  const who = pick ? pick.who : line.who;
                  const src = face(pick ? pick.face : line.face ?? null);
                  const maybe = open && heroes.length < HEROES.length ? heroes.map((h) => heroName(h, lang)).join(' / ') : null;
                  return (
                    <article class={`line side-${line.side}`} id={anchor} data-id={line.id}>
                      <div class="face-col">
                        {src ? <img class="face" src={src} alt="" width="160" height="160" loading="lazy" /> : <div class="face none" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg></div>}
                        <a class="lid latin" href={`#${anchor}`}>@{line.id}</a>
                      </div>
                      <div class="body">
                        <div class="who">
                          <strong class="name">{who[lang]}</strong>
                          {lang !== 'ja' && who.ja && who.ja !== who[lang] && <span class="wja" lang="ja">{who.ja}</span>}
                          {open ? <span class="route">{maybe ?? t.heroDep[lang]}</span> : route && <span class="route">{route}</span>}
                          {review && <button type="button" class="act" data-suggest={line.id}>{t.suggest[lang]}</button>}
                        </div>
                        {trLangs.map((l) => <div class={`tr tr-${l}`} lang={l === 'zh' ? 'zh-Hans' : l}>{line[l].map((p) => <p set:html={rich(p, l, hero)} />)}</div>)}
                        <div class="ja" lang="ja"><span class="ja-lbl">{t.jaLabel[lang]}</span><div>{line.ja.map((p) => <p set:html={rich(p, 'ja', hero)} />)}</div></div>
                      </div>
                    </article>
                  );
                })}
              </div>
            ))}
          </section>
        ))}
        <nav class="pager">
          {s.previous.map((n) => <a href={`/${lang}/story/${n}/`}>← {titleOf(n)}</a>)}
          <span></span>
          {s.next.map((n) => <a class="r" href={`/${lang}/story/${n}/`}>{titleOf(n)} →</a>)}
        </nav>
        <p class="foot">{t.note[lang]}</p>
      </main>
    </div>
  </div>
  <script>
    import { initStory } from '../../../scripts/story';
    initStory();
  </script>
  <script>
    import { initSuggestions } from '../../../scripts/suggest';
    initSuggestions();
  </script>
</Base>

<style>
  /* Header band. */
  .hero { background: linear-gradient(180deg, #0d1638, #0a1130); border-bottom: 1px solid var(--line); }
  .hero .wrap { padding-top: 22px; padding-bottom: 22px; }
  .back { font-size: 13px; color: var(--muted); }
  .kicker { margin-top: 14px; color: var(--orange); font-size: 13px; font-weight: 700; letter-spacing: 0.12em; }
  .hero h1 { margin-top: 4px; font-size: clamp(26px, 3.6vw, 40px); }
  .stno { color: var(--gold); }
  .jt { margin-top: 4px; color: var(--muted); }
  .sub { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px 16px; align-items: center; font-size: 14px; color: var(--dim); }
  .pn a + a::before { content: ' / '; color: var(--dim); }
  .lane { padding: 0 8px; font-size: 12px; color: var(--cyan); border: 1px solid rgba(63, 208, 255, 0.4); border-radius: 10px; }
  .stats { border-top: 1px solid var(--line-soft); }
  .stats-in { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); padding-top: 0 !important; padding-bottom: 0 !important; }
  .stats-in > div { display: grid; gap: 2px; padding: 14px 18px; border-left: 1px solid var(--line-soft); }
  .stats-in > div:first-child { border-left: 0; padding-left: 0; }
  .stats b { font-size: 26px; color: #fff; }
  .stats span { font-size: 12px; color: var(--dim); }

  /* Search and view bar. */
  .bar { position: sticky; top: 64px; z-index: 12; background: rgba(9, 14, 36, 0.97); border-bottom: 1px solid var(--line-soft); }
  .bar-in { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding-top: 10px; padding-bottom: 10px; }
