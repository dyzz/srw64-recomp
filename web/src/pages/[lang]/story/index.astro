---
import Base from '../../../layouts/Base.astro';
import StorySearch from '../../../components/StorySearch.astro';
import { langPaths, UI, type Lang } from '../../../i18n';
import { storyGroups, storyIndex } from '../../../lib/data';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const groups = storyGroups(lang);
const total = storyIndex().reduce((n, s) => n + s.count, 0);
const t = {
  lead: {
    zh: `全部剧情按话数排好，日文原文与译文逐句对照，共 ${total.toLocaleString()} 句。读到别扭的地方，点一下就能提意见。`,
    en: `The whole script in episode order, Japanese and translation line by line: ${total.toLocaleString()} lines. If a line reads oddly, one click sends a suggestion.`,
    ja: `全シナリオを話数順に、日本語原文と翻訳を一行ずつ対照。全 ${total.toLocaleString()} 行。気になる訳があれば、ワンクリックで意見を送れます。`,
  },
  stage: { zh: (n: string) => `第 ${n} 话`, en: (n: string) => `Stage ${n}`, ja: (n: string) => `第${n}話` },
  lines: { zh: '句', en: 'lines', ja: '行' },
};
---
<Base lang={lang} title={UI.nav.story[lang]}>
  <div class="wrap">
    <header class="page-head">
      <span class="tag">STORY</span>
      <h1>{UI.nav.story[lang]}</h1>
      <p>{t.lead[lang]}</p>
      <StorySearch lang={lang} />
    </header>

    {groups.map((g) => (
      <section class="group">
        <h2>{g.title}</h2>
        <ul class="eps">
          {g.scenes.map((s) => (
            <li>
              <a class="ep" href={`/${lang}/story/${s.scene}/`}>
                <span class="num latin">{s.episode ? t.stage[lang](s.episode.stage) : `#${s.scene}`}</span>
                <span class="title">
                  <strong>{s.title[lang]}</strong>
                  {lang !== 'ja' && <span class="ja-title" lang="ja">{s.title.ja}</span>}
                </span>
                <span class="meta">
                  {s.episode?.lanes.map((l) => <span class="lane">{l[lang]}</span>)}
                  <span class="count">{s.count} {t.lines[lang]}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
  .group { margin-top: 40px; }
  .group h2 { font-size: 20px; padding-left: 14px; border-left: 4px solid var(--gold); margin-bottom: 14px; }
  .eps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .ep { display: grid; grid-template-columns: 76px minmax(0, 1fr) auto; gap: 14px; align-items: center; padding: 12px 16px; color: var(--text); text-decoration: none !important; background: var(--panel); border: 1px solid var(--line-soft); }
  .ep:hover { border-color: var(--cyan); background: var(--panel-2); }
  .num { font-size: 14px; font-weight: 700; color: var(--gold); }
  .title { display: grid; min-width: 0; }
  .title strong { font-size: 16px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ja-title { font-size: 13px; color: var(--dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .meta { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; justify-content: flex-end; }
  .lane { padding: 0 8px; font-size: 12px; color: var(--cyan); border: 1px solid rgba(63, 208, 255, 0.4); border-radius: 10px; white-space: nowrap; }
  .count { font-size: 12px; color: var(--dim); white-space: nowrap; }
  @media (max-width: 860px) { .eps { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .ep { grid-template-columns: 60px minmax(0, 1fr); } .meta { grid-column: 2; justify-content: flex-start; } }
</style>
