---
import Base from '../../../layouts/Base.astro';
import StorySearch from '../../../components/StorySearch.astro';
import { langPaths, UI, type Lang } from '../../../i18n';
import { storyGroups, storyIndex, storySource } from '../../../lib/data';

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const groups = storyGroups(lang);
const total = storyIndex().reduce((n, s) => n + s.count, 0);
// Lines changed since the latest game release, in this page's translation (none on ja).
const source = storySource();
const changedLang = lang === 'ja' ? null : lang;
const changedTotal = changedLang ? storyIndex().reduce((n, s) => n + (s.changed?.[changedLang] ?? 0), 0) : 0;
const t = {
  lead: {
    zh: `全部剧情按话数排列，共 ${total.toLocaleString()} 句，日文原文与译文逐句对照。如有修改建议，可以在对应台词旁提交。`,
    en: `The full script in stage order, with the original Japanese and translations side by side: ${total.toLocaleString()} lines. You can submit a suggestion beside any line.`,
    ja: `全シナリオを話数順に掲載し、日本語原文と翻訳を一行ずつ対照できます。全 ${total.toLocaleString()} 行。修正案は各セリフの横から送れます。`,
  },
  stage: { zh: (n: string) => `第 ${n} 话`, en: (n: string) => `Stage ${n}`, ja: (n: string) => `第${n}話` },
  lines: { zh: '句', en: 'lines', ja: '行' },
  enter: { zh: '进入关卡', en: 'Open', ja: '開く' },
  stages: { zh: (n: number) => `${n} 话`, en: (n: number) => `${n} stages`, ja: (n: number) => `${n} ステージ` },
  changedTotal: {
    zh: (n: number, v: string) => `自 ${v} 发布以来，译文共更新 ${n.toLocaleString()} 句；各关的更新数标在卡片上，点击即可只看这些台词和改动对照。`,
    en: (n: number, v: string) => `Since ${v}, ${n.toLocaleString()} lines of the translation have changed. Each stage card shows its count; click it to see only those lines, old and new compared.`,
    ja: (_n: number, _v: string) => '',
  },
  changed: { zh: (n: number) => `更新 ${n}`, en: (n: number) => `${n} changed`, ja: (n: number) => `更新 ${n}` },
  history: { zh: '按提交查看更新历史 →', en: 'History by commit →', ja: 'コミットごとの更新履歴 →' },
};
// Scenes that share a stage number (one per route) sit side by side, as on the SRW Z site.
type Meta = ReturnType<typeof storyIndex>[number];
function rows(scenes: Meta[]) {
  const out: { stage: string | null; scenes: Meta[] }[] = [];
  for (const s of scenes) {
    const stage = s.episode?.stage ?? null;
    const last = out[out.length - 1];
    if (stage && last?.stage === stage) last.scenes.push(s); else out.push({ stage, scenes: [s] });
  }
  return out;
}
---
<Base lang={lang} title={UI.nav.story[lang]}>
  <div class="wrap">
    <header class="page-head">
      <span class="tag">STORY</span>
      <h1>{UI.nav.story[lang]}</h1>
      <p>{t.lead[lang]}</p>
      {changedLang && source && changedTotal > 0 && <p class="changed-total">{t.changedTotal[lang](changedTotal, source.baseline)} <a href={`/${lang}/story/history/`}>{t.history[lang]}</a></p>}
      <StorySearch lang={lang} />
    </header>

    {groups.map((g) => (
      <section class="group">
        <div class="ghead"><h2>{g.title}</h2><span class="gcount">{t.stages[lang](rows(g.scenes).length)}</span></div>
        <div class="rows">
          {rows(g.scenes).map((r) => (
            <div class="row">
              <div class="num"><span class="latin">{r.stage ?? '·'}</span><small>{r.stage ? 'STAGE' : 'SCENE'}</small></div>
              <div class="cards">
                {r.scenes.map((s) => (
                  <a class="card" href={`/${lang}/story/${s.scene}/`}>
                    <span class="lanes">{s.episode?.lanes.length ? s.episode.lanes.map((l) => <span class="lane">{l[lang]}</span>) : <span class="lane dim">#{s.scene}</span>}</span>
                    <strong>{s.title[lang]}</strong>
                    {lang !== 'ja' && <span class="ja-title" lang="ja">{s.title.ja}</span>}
                    <span class="foot"><span class="count">{s.count} {t.lines[lang]}</span>{changedLang && (s.changed?.[changedLang] ?? 0) > 0 && <span class="chg" data-href={`/${lang}/story/${s.scene}/?changed=1`}>{t.changed[lang](s.changed![changedLang])}</span>}<span class="go">{t.enter[lang]} →</span></span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>

<script>
  // The card is a link to the stage; its change count opens the stage with only those lines.
  document.querySelectorAll<HTMLElement>('.chg[data-href]').forEach((b) => b.addEventListener('click', (ev) => {
    ev.preventDefault();
    location.href = b.dataset.href!;
  }));
</script>

<style>
  .group { margin-top: 44px; }
  .ghead { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-bottom: 10px; margin-bottom: 14px; border-bottom: 2px solid var(--text); }
  .ghead h2 { font-size: 20px; }
  .gcount { font-size: 12px; color: var(--dim); white-space: nowrap; }
  .rows { display: grid; gap: 10px; }
  .row { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 10px; }
  .num { display: grid; place-content: center; justify-items: center; background: #0d1638; border: 1px solid var(--line-soft); color: #fff; }
  .num span { font-size: 26px; font-weight: 700; line-height: 1; }
  .num small { margin-top: 4px; font-size: 9px; letter-spacing: 0.14em; color: var(--dim); }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 10px; }
  .card { display: grid; gap: 3px; align-content: start; padding: 12px 14px; color: var(--text); text-decoration: none !important; background: var(--panel); border: 1px solid var(--line-soft); border-top: 3px solid var(--orange); }
  .card:hover { border-color: var(--cyan); border-top-color: var(--cyan); background: var(--panel-2); }
  .lanes { display: flex; flex-wrap: wrap; gap: 4px; }
  .lane { padding: 0 8px; font-size: 11px; color: var(--cyan); border: 1px solid rgba(63, 208, 255, 0.4); border-radius: 10px; }
  .lane.dim { color: var(--dim); border-color: var(--line-soft); }
  .card strong { margin-top: 4px; font-size: 17px; }
  .ja-title { font-size: 13px; color: var(--dim); }
  .foot { display: flex; justify-content: space-between; align-items: center; margin-top: 8px; }
  .count { font-size: 12px; color: var(--dim); }
  /* Lines changed since the release: opens the stage showing only those, compared. */
  .chg { margin-left: auto; margin-right: 10px; padding: 1px 7px; font-size: 12px; color: var(--gold); border: 1px solid rgba(255, 215, 94, 0.45); cursor: pointer; }
  .chg:hover { color: var(--bg); background: var(--gold); }
  .changed-total { font-size: 14px; color: var(--gold); }
  .go { font-size: 12px; font-weight: 700; color: var(--orange); }
  .card:hover .go { color: var(--cyan); }
  @media (max-width: 560px) { .row { grid-template-columns: 48px minmax(0, 1fr); } .num span { font-size: 20px; } }
</style>
