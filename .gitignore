# Local Python environments and packaging output
/.venv/
/venv/
/dist/
/build/
# Exported resources stay local; only the directory guide is tracked.
/assets/*
!/assets/README.md
*.egg-info/
*.py[cod]
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Proprietary/local game inputs and emulator state
/ref-project/
*.z64
*.n64
*.v64
*.ram
*.sav
*.srm
*.state
*.sram
*.eep
*.mpk
*.fla
*.dump
*.payload
*.bin
*.elf
*.dylib

# Local fonts, archives, logs, and environment overrides
*.otf
*.ttf
# Our own symbol font (DejaVu triangles + a drawn wrench) ships from the repository.
!/content/fonts/SRW64Symbols.ttf
!/content/fonts/SRW64Prompts.ttf
# HarmonyOS Sans, unmodified with its licence (redistribution with the software is allowed).
!/content/fonts/HarmonyOS_Sans_SC.ttf
!/content/fonts/HarmonyOS_Sans_Condensed.ttf
*.zip
*.7z
*.tar
*.tar.gz
*.log
.env
.env.*
!.env.example

# Generated native code, binaries, local tools and web dependencies
node_modules/
CMakeFiles/
CMakeCache.txt
*.o
*.obj
*.a
*.so
*.exe
*.dSYM/
/.claude/
/.codex/

# Captures stay local; only reviewed documentation media may be published.
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.mov
!/docs/media/*.png
!/docs/media/*.jpg
!/docs/media/*.webp
!/docs/media/reading-demo.mp4
# The website design notes name the server; they stay local (tests/test_docs.py skips them).
/docs/design/website.md
# Builds on a machine of the maintainer's over ssh; stays local.
/tools/release/linux/build_remote.py
# The website's screenshots, comparisons and brand images (web/README.md).
!/web/public/media/*.webp
!/web/public/brand/*.png
!/web/public/brand/*.webp

# Editor and operating-system metadata
.DS_Store
.idea/
.vscode/
*.swp
*~
# Steam library artwork for the Linux package (tools/release/linux/steam_art.py makes it).
!/tools/release/linux/steam-art/*.png
