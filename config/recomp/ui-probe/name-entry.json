{
  "schema": "srw64.ui-probe-script.v1",
  "actions": [
    {"op":"expect","state":{"person":3,"route":0,"starts":0}},
    {"op":"capture","name":"01-select-en.png"},
    {"op":"key","key":"Right"},
    {"op":"expect","state":{"route":1}},
    {"op":"language","locale":"zh-Hans"},
    {"op":"capture","name":"02-select-zh.png"},
    {"op":"key","key":"Escape"},
    {"op":"expect","state":{"person":3,"backs":0}},
    {"op":"key","key":"Return"},
    {"op":"expect","state":{"person":2,"route":1}},
    {"op":"capture","name":"03-review-zh.png"},
    {"op":"language","locale":"ja"},
    {"op":"resize","width":900,"height":760},
    {"op":"capture","name":"04-review-ja.png"},
    {"op":"key","key":"Escape"},
    {"op":"expect","state":{"person":3,"backs":1}},
    {"op":"click","id":"route3"},
    {"op":"click","id":"next"},
    {"op":"expect","state":{"person":2,"route":3}},
    {"op":"language","locale":"en"},
    {"op":"capture","name":"05-review-en.png"},
    {"op":"click","id":"next"},
    {"op":"expect","state":{"starts":1,"visible":false}},
    {"op":"quit"}
  ]
}
