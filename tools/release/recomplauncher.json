{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "game": {
    "kind": "iso",
    "label": "Your ROM of Super Robot Taisen 64 (Japan, Rev 0): .z64, .n64 or .v64.",
    "into": ".",
    "name": "rom.z64",
    "dumps": [{ "name": "Japan Rev 0", "size": 33554432, "crc32": "85df2771" }]
  },
  "start": {
    "program": [
      "Marchwind64.exe",
      "Marchwind64-windows-x64/Marchwind64.exe",
      "marchwind64.sh",
      "Marchwind64-linux-x64/marchwind64.sh",
      "Marchwind64.app/Contents/MacOS/srw64-gfx-host"
    ],
    "args": []
  },
  "config": [
    {
      "id": "main",
      "format": "json",
      "file": [
        { "path": "{install}/user-data/presentation.json", "if": "{install}/user-data" },
        { "path": "{install}/Marchwind64-windows-x64/user-data/presentation.json", "if": "{install}/Marchwind64-windows-x64/user-data" },
        { "path": "{install}/Marchwind64-linux-x64/user-data/presentation.json", "if": "{install}/Marchwind64-linux-x64/user-data" },
        { "path": "{local}/SRW64Recomp/presentation.json", "if": "{local}/SRW64Recomp" },
        { "path": "{local}/srw64-recomp/presentation.json", "if": "{local}/srw64-recomp" },
        { "path": "{home}/Library/Application Support/SRW64Recomp/presentation.json", "if": "{home}/Library/Application Support/SRW64Recomp" },
        { "path": "{local}/SRW64Recomp/presentation.json" }
      ]
    }
  ],
  "settings": [
    {
      "id": "language",
      "label": "Language",
      "help": "The game's text and menus. Unset, it follows your system.",
      "choices": [
        { "label": "简体中文", "set": { "locale": "zh-Hans" } },
        { "label": "繁體中文", "set": { "locale": "zh-Hant" } },
        { "label": "English", "set": { "locale": "en" } },
        { "label": "日本語", "set": { "locale": "ja" } },
        { "label": "한국어", "set": { "locale": "ko" } }
      ]
    },
    {
      "id": "ui_size",
      "label": "Interface size",
      "help": "Largest is made for handheld screens.",
      "choices": [
        { "label": "Standard", "set": { "ui_size": "standard" } },
        { "label": "Large", "set": { "ui_size": "large" } },
        { "label": "Largest", "set": { "ui_size": "largest" } }
      ],
      "defaults": { "ui_size": "standard" }
    },
    {
      "id": "refresh_rate",
      "label": "Frame rate",
      "help": "Display follows your monitor with interpolated frames; Original is the N64's own.",
      "choices": [
        { "label": "Display", "set": { "refresh_rate": "display" } },
        { "label": "60", "set": { "refresh_rate": "60" } },
        { "label": "Original", "set": { "refresh_rate": "original" } }
      ],
      "defaults": { "refresh_rate": "display" }
    },
    {
      "id": "map_unit_icons",
      "label": "Map unit icons",
      "help": "HD icons need the HD pack installed.",
      "choices": [
        { "label": "HD", "set": { "map_unit_icons": "hd" } },
        { "label": "Original", "set": { "map_unit_icons": "original" } }
      ],
      "defaults": { "map_unit_icons": "hd" }
    }
  ],
  "prepare": {
    "program": [
      "Marchwind64.exe",
      "Marchwind64-windows-x64/Marchwind64.exe",
      "marchwind64.sh",
      "Marchwind64-linux-x64/marchwind64.sh",
      "Marchwind64.app/Contents/MacOS/srw64-gfx-host"
    ],
    "args": ["--prepare"],
    "label": "The HD art pack (about 630 MB)",
    "timeout": 7200
  },
  "looks": { "graphics": "d3d12", "lines": 240 },
  "saves": [
    "{install}/user-data/saves",
    "{install}/Marchwind64-windows-x64/user-data/saves",
    "{install}/Marchwind64-linux-x64/user-data/saves",
    "{local}/SRW64Recomp/saves",
    "{local}/srw64-recomp/saves",
    "{home}/Library/Application Support/SRW64Recomp/saves"
  ],
  "folders": {
    "data": [
      { "path": "{install}/user-data", "if": "{install}/user-data" },
      { "path": "{install}/Marchwind64-windows-x64/user-data", "if": "{install}/Marchwind64-windows-x64/user-data" },
      { "path": "{install}/Marchwind64-linux-x64/user-data", "if": "{install}/Marchwind64-linux-x64/user-data" },
      { "path": "{local}/SRW64Recomp", "if": "{local}/SRW64Recomp" },
      { "path": "{local}/srw64-recomp", "if": "{local}/srw64-recomp" },
      { "path": "{home}/Library/Application Support/SRW64Recomp", "if": "{home}/Library/Application Support/SRW64Recomp" },
      { "path": "{local}/SRW64Recomp" }
    ],
    "saves": [
      { "path": "{install}/user-data/saves", "if": "{install}/user-data" },
      { "path": "{install}/Marchwind64-windows-x64/user-data/saves", "if": "{install}/Marchwind64-windows-x64/user-data" },
      { "path": "{install}/Marchwind64-linux-x64/user-data/saves", "if": "{install}/Marchwind64-linux-x64/user-data" },
      { "path": "{local}/SRW64Recomp/saves", "if": "{local}/SRW64Recomp" },
      { "path": "{local}/srw64-recomp/saves", "if": "{local}/srw64-recomp" },
      { "path": "{home}/Library/Application Support/SRW64Recomp/saves", "if": "{home}/Library/Application Support/SRW64Recomp" },
      { "path": "{local}/SRW64Recomp/saves" }
    ],
    "logs": [
      { "path": "{install}/user-data/logs", "if": "{install}/user-data" },
      { "path": "{install}/Marchwind64-windows-x64/user-data/logs", "if": "{install}/Marchwind64-windows-x64/user-data" },
      { "path": "{install}/Marchwind64-linux-x64/user-data/logs", "if": "{install}/Marchwind64-linux-x64/user-data" },
      { "path": "{local}/SRW64Recomp/logs", "if": "{local}/SRW64Recomp" },
      { "path": "{local}/srw64-recomp/logs", "if": "{local}/srw64-recomp" },
      { "path": "{home}/Library/Application Support/SRW64Recomp/logs", "if": "{home}/Library/Application Support/SRW64Recomp" },
      { "path": "{local}/SRW64Recomp/logs" }
    ]
  },
  "actions": [
    { "id": "open-data", "label": "Open the data folder",
      "help": "The HD art pack the setup installed is here as hd/ (remove it to play with the original graphics; no hd/ means its download failed, so set the game up again). Filters, bezels and mods live here too.",
      "open": "data" },
    { "id": "open-saves", "label": "Open the saves folder", "help": "Where your save slots are kept.", "open": "saves" }
  ],
  "exit_codes": {
    "1": "No file dialog is available to pick your ROM. Put it as rom.z64 next to the game and press Play again.",
    "2": "Marchwind64 could not start and has shown why. If it asked for your ROM, pick it again on the next Play."
  }
}
