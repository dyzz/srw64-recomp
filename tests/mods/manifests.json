{
  "about": "mod.json cases shared by tests/native_mod_library.cpp (src/host/mod_library.hpp parse_manifest) and tests/test_mod_validate.py (tools/mods/validate.py): the same manifest must give the same problem code, empty when it is fine. docs/design/mod-packages.md §2 and §13.4.",
  "cases": [
    {"case": "minimal", "problem": "",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0.0", "name": {"en": "a.b"}}},
    {"case": "everything", "problem": "",
     "manifest": {"schema": "srw64.mod.v1", "id": "example.gaiden", "version": "1.2.0",
                  "name": {"ja": "外伝", "zh-Hans": "外传", "en": "Gaiden"}, "description": {"zh-Hans": "说明"},
                  "authors": ["example"], "license": "CC-BY-NC-4.0", "game": ">=0.4 <2",
                  "requires": {"example.newpilots": ">=1.0"}, "optional": {"srw64.hd": "*"}, "conflicts": {"someone.oldgaiden": "*"}}},
    {"case": "name as a plain string", "problem": "",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "2", "name": "Plain"}},
    {"case": "not an object", "problem": "manifest", "manifest": []},
    {"case": "unknown field", "problem": "field",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": "x", "colour": "red"}},
    {"case": "old schema", "problem": "schema",
     "manifest": {"schema": "srw64.mod.v2", "id": "a.b", "version": "1.0", "name": "x"}},
    {"case": "no schema", "problem": "schema",
     "manifest": {"id": "a.b", "version": "1.0", "name": "x"}},
    {"case": "id with a slash", "problem": "id",
     "manifest": {"schema": "srw64.mod.v1", "id": "a/b", "version": "1.0", "name": "x"}},
    {"case": "id too long", "problem": "id",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "version": "1.0", "name": "x"}},
    {"case": "version in words", "problem": "version",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "one", "name": "x"}},
    {"case": "four-part version", "problem": "version",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.2.3.4", "name": "x"}},
    {"case": "version missing", "problem": "version",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "name": "x"}},
    {"case": "empty name", "problem": "name",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": ""}},
    {"case": "name map with a number", "problem": "name",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": {"en": 3}}},
    {"case": "description not text", "problem": "description",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": "x", "description": 5}},
    {"case": "authors not a list", "problem": "authors",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": "x", "authors": "me"}},
    {"case": "licence not in the list", "problem": "license",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": "x", "license": "All rights reserved"}},
    {"case": "licence not a string", "problem": "license",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": "x", "license": true}},
    {"case": "game requirement in words", "problem": "game",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": "x", "game": "newer"}},
    {"case": "game requirement with a tilde", "problem": "game",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": "x", "game": "~1.0"}},
    {"case": "requires itself", "problem": "requires",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": "x", "requires": {"a.b": "*"}}},
    {"case": "requires not a map", "problem": "requires",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": "x", "requires": ["c.d"]}},
    {"case": "optional with a bad requirement", "problem": "optional",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": "x", "optional": {"c.d": ">= 1"}}},
    {"case": "conflicts with a bad id", "problem": "conflicts",
     "manifest": {"schema": "srw64.mod.v1", "id": "a.b", "version": "1.0", "name": "x", "conflicts": {"c d": "*"}}}
  ]
}
